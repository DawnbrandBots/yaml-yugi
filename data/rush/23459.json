{"konami_id": 23459, "name": {"en": "Gagaga Cheergirl", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30ac\u30ac\u30ac\u30c1\u30a2\u30ac\u30fc\u30eb", "ja_romaji": "Gagaga Chiag\u0101ru", "ko": "\uac00\uac00\uac00 \uce58\uc5b4\uac78", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "None", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u306a\u3057", "ko": "\uc5c6\uc74c", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Send 2 face-up Level 4 FIRE Attribute monsters from your field to the Graveyard. Then, you can Special Summon 1 FIRE Attribute monster from your Graveyard face-up to your field. If you do, you can make 1 face-up monster on your opponent's field lose 1000 ATK until the end of this turn. This turn, you cannot activate the effect of \"Gagaga Cheergirl\".", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u8868\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff14\uff0f\u708e\u5c5e\u6027\uff09\uff12\u4f53\u3092\u5893\u5730\u3078\u9001\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u708e\u5c5e\u6027\uff09\uff11\u4f53\u3092\u9078\u3093\u3067\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3067\u304d\u308b\u3002\u7279\u6b8a\u53ec\u559a\u3057\u305f\u5834\u5408\u3001\u3055\u3089\u306b\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u8868\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\uff11\u4f53\u3092\u9078\u3093\u3067\u305d\u306e\u653b\u6483\u529b\u3092\u30bf\u30fc\u30f3\u7d42\u4e86\u6642\u307e\u3067\uff11\uff10\uff10\uff10\u30c0\u30a6\u30f3\u3067\u304d\u308b\u3002\u3053\u306e\u30bf\u30fc\u30f3\u3001\u81ea\u5206\u306f\u300c\u30ac\u30ac\u30ac\u30c1\u30a2\u30ac\u30fc\u30eb\u300d\u306e\u52b9\u679c\u3092\u767a\u52d5\u3067\u304d\u306a\u3044\u3002", "ko": "\uc790\uc2e0 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130(\ub808\ubca8 4 / \ud654\uc5fc \uc18d\uc131) 2\uc7a5\uc744 \ubb18\uc9c0\ub85c \ubcf4\ub0b8\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ud654\uc5fc \uc18d\uc131) 1\uc7a5\uc744 \uace0\ub974\uace0 \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4. \ud2b9\uc218 \uc18c\ud658\ud588\uc744 \uacbd\uc6b0, \ucd94\uac00\ub85c \uc0c1\ub300 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130 1\uc7a5\uc744 \uace0\ub974\uace0 \uadf8 \uacf5\uaca9\ub825\uc744 \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0 1000 \ub0b4\ub9b4 \uc218 \uc788\ub2e4. \uc774 \ud134\uc5d0, \uc790\uc2e0\uc740 \"\uac00\uac00\uac00 \uce58\uc5b4\uac78\"\uc758 \ud6a8\uacfc\ub97c \ubc1c\ub3d9\ud560 \uc218 \uc5c6\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Warrior / Effect", "attribute": "FIRE", "level": 4, "atk": 1000, "def": 400, "series": ["Baseball"], "images": [{"index": 1, "image": "GagagaCheergirl-RDAP03-JP-UR.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP033", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Over Rush Rare"]}], "ko": [{"set_number": "RD/AP03-KR033", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Over Rush Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1203872}