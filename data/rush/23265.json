{"konami_id": 23265, "name": {"en": "Twilight Companion - Dralia", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u9ec4<rt>\u305f\u305d</rt></ruby><ruby>\u660f<rt>\u304c\u308c</rt></ruby>\u306e<ruby>\u53cb<rt>\u3068\u3082</rt></ruby>\u3060\u3061 \u30c9\u30e9\u30ea\u30a2", "ja_romaji": "Tasogare no Tomodachi Doraria", "ko": "\ud669\ud63c\uc758 \uce5c\uad6c \ub4dc\ub77c\ub9ac\uc544", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "summoning_condition": {"en": "If you have a card in your Field Zone or you have a Field Spell Card in your Graveyard, you can Normal Summon this card without Tributing.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u30d5\u30a3\u30fc\u30eb\u30c9\u30be\u30fc\u30f3\u306b\u30ab\u30fc\u30c9\u304c\u3042\u308b\u5834\u5408\u307e\u305f\u306f\u81ea\u5206\u306e\u5893\u5730\u306b\u30d5\u30a3\u30fc\u30eb\u30c9\u9b54\u6cd5\u30ab\u30fc\u30c9\u304c\u3042\u308b\u5834\u5408\u3001\u3053\u306e\u30ab\u30fc\u30c9\u306f\u30ea\u30ea\u30fc\u30b9\u306a\u3057\u3067\u53ec\u559a\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0\uc758 \ud544\ub4dc \uc874\uc5d0 \uce74\ub4dc\uac00 \uc788\uc744 \uacbd\uc6b0 \ub610\ub294 \uc790\uc2e0 \ubb18\uc9c0\uc5d0 \ud544\ub4dc \ub9c8\ubc95 \uce74\ub4dc\uac00 \uc788\uc744 \uacbd\uc6b0, \uc774 \uce74\ub4dc\ub294 \ub9b4\ub9ac\uc2a4 \uc5c6\uc774 \uc77c\ubc18 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Place 2 EARTH Attribute Galaxy Type monsters from your Graveyard on the bottom of the Deck in any order.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5730\u5c5e\u6027\uff0f\u30ae\u30e3\u30e9\u30af\u30b7\u30fc\u65cf\uff09\uff12\u4f53\u3092\u597d\u304d\u306a\u9806\u756a\u3067\u30c7\u30c3\u30ad\u306e\u4e0b\u306b\u623b\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ub545 \uc18d\uc131 / \uac24\ub7ed\uc2dc\uc871) 2\uc7a5\uc744 \uc88b\uc544\ud558\ub294 \uc21c\uc11c\ub300\ub85c \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9ac\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "This card gains 600 ATK until the end of this turn. Then, you can place 1 Spell Card from your Graveyard on top of the Deck, except a Normal Spell Card.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u306e\u653b\u6483\u529b\u306f\u30bf\u30fc\u30f3\u7d42\u4e86\u6642\u307e\u3067\uff16\uff10\uff10\u30a2\u30c3\u30d7\u3059\u308b\u3002\u305d\u306e\u5f8c\u3001\u901a\u5e38\u9b54\u6cd5\u30ab\u30fc\u30c9\u4ee5\u5916\u306e\u81ea\u5206\u306e\u5893\u5730\u306e\u9b54\u6cd5\u30ab\u30fc\u30c9\uff11\u679a\u3092\u9078\u3093\u3067\u30c7\u30c3\u30ad\u306e\u4e0a\u306b\u623b\u3059\u4e8b\u304c\u3067\u304d\u308b\u3002", "ko": "\uc774 \uce74\ub4dc\uc758 \uacf5\uaca9\ub825\uc740 \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0 600 \uc62c\ub9b0\ub2e4. \uadf8 \ud6c4, \uc77c\ubc18 \ub9c8\ubc95 \uce74\ub4dc \uc774\uc678\uc758 \uc790\uc2e0 \ubb18\uc9c0\uc758 \ub9c8\ubc95 \uce74\ub4dc 1\uc7a5\uc744 \uace0\ub974\uace0 \ub371 \uc704\ub85c \ub418\ub3cc\ub9b4 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Galaxy / Effect", "attribute": "EARTH", "level": 5, "atk": 1900, "def": 1900, "series": ["Moonforce"], "images": [{"index": 1, "image": "TwilightCompanionDralia-RDKP25-JP-R.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP068", "set_name": "Rising of the Aurora", "rarities": ["Rare", "Secret Rare"]}], "ko": [{"set_number": "RD/KP25-KR068", "set_name": "Rising of the Aurora", "rarities": ["Rare", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1191100}