{"konami_id": 23442, "name": {"en": "Union Supporter", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30e6\u30cb\u30aa\u30f3\u30fb\u30b5\u30dd\u30fc\u30bf\u30fc", "ja_romaji": "Yunion Sap\u014dt\u0101", "ko": "\uc720\ub2c8\uc628 \uc11c\ud3ec\ud130", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Send the top card of your Deck to the Graveyard, and declare 1 card name from among \"X-Head Cannon\", \"Y-Dragon Head\", and \"Z-Metal Tank\".", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30c7\u30c3\u30ad\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u3092\u5893\u5730\u3078\u9001\u308a\u3001\u300c\uff38\uff0d\u30d8\u30c3\u30c9\u30fb\u30ad\u30e3\u30ce\u30f3\u300d\u300c\uff39\uff0d\u30c9\u30e9\u30b4\u30f3\u30fb\u30d8\u30c3\u30c9\u300d\u300c\uff3a\uff0d\u30e1\u30bf\u30eb\u30fb\u30ad\u30e3\u30bf\u30d4\u30e9\u30fc\u300d\u306e\u3044\u305a\u308c\u304b\uff11\u4f53\u306e\u30ab\u30fc\u30c9\u540d\u3092\u5ba3\u8a00\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\ub371 \ub9e8 \uc704\uc758 \uce74\ub4dc\ub97c \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0, \"X\uff0d\ud5e4\ub4dc \uce90\ub17c\" \"Y\uff0d\ub4dc\ub798\uace4 \ud5e4\ub4dc\" \"Z\uff0d\uba54\ud0c8 \uce90\ud130\ud544\ub7ec\" \uc911 \uc5b4\ub290 1\uc7a5\uc758 \uce74\ub4dc\uba85\uc744 \uc120\uc5b8\ud558\uc5ec \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "This turn, this card's name becomes the name declared to meet the requirement. Then, you can Special Summon 1 Level 6 LIGHT Attribute Machine Type Fusion Monster from your Graveyard to your field in face-up Defense Position.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u306e\u30ab\u30fc\u30c9\u540d\u306f\u3053\u306e\u30bf\u30fc\u30f3\u3001\u3053\u306e\u52b9\u679c\u306e\u6761\u4ef6\u3067\u5ba3\u8a00\u3057\u305f\u30ab\u30fc\u30c9\u540d\u306b\u306a\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff16\uff0f\u5149\u5c5e\u6027\uff0f\u6a5f\u68b0\u65cf\uff09\uff11\u4f53\u3092\u9078\u3093\u3067\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u5b88\u5099\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3067\u304d\u308b\u3002", "ko": "\uc774 \uce74\ub4dc\uc758 \uce74\ub4dc\uba85\uc740 \uc774 \ud134\uc5d0, \uc774 \ud6a8\uacfc\uc758 \uc870\uac74\uc73c\ub85c \uc120\uc5b8\ud55c \uce74\ub4dc\uba85\uc774 \ub41c\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0 \ubb18\uc9c0\uc758 \ud4e8\uc804 \ubaac\uc2a4\ud130(\ub808\ubca8 6 / \ube5b \uc18d\uc131 / \uae30\uacc4\uc871) 1\uc7a5\uc744 \uace0\ub974\uace0 \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \uc218\ube44 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Machine / Effect", "attribute": "LIGHT", "level": 4, "atk": 1000, "def": 1000, "series": ["XYZ"], "images": [{"index": 1, "image": "UnionSupporter-RDAP03-JP-UR.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP011", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Secret Rare"]}], "ko": [{"set_number": "RD/AP03-KR011", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1196067}