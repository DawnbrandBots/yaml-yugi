{"konami_id": 23439, "name": {"en": "X-Trial Cannon", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\uff38<rt>\u30a8\u30c3\u30af\u30b9</rt></ruby>\uff0d\u30c8\u30e9\u30a4\u30a2\u30eb\u30fb\u30ad\u30e3\u30ce\u30f3", "ja_romaji": "Ekkusu - Toraiaru Kyanon", "ko": "X\uff0d\ud2b8\ub77c\uc774\uc5bc \uce90\ub17c", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Send the top 2 cards of your Deck to the Graveyard.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30c7\u30c3\u30ad\u306e\u4e0a\u304b\u3089\u30ab\u30fc\u30c9\uff12\u679a\u3092\u5893\u5730\u3078\u9001\u3063\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\ub371 \uc704\uc5d0\uc11c \uce74\ub4dc 2\uc7a5\uc744 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "This turn, this card's name becomes \"X-Head Cannon\". Then, you can add 1 \"Y-Trial Dragon\" or \"Z-Trial Tank\" from your Graveyard to your hand. You cannot Special Summon non-LIGHT Attribute monsters from the Extra Deck until the end of this turn.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u306e\u30ab\u30fc\u30c9\u540d\u306f\u3053\u306e\u30bf\u30fc\u30f3\u3001\u300c\uff38\uff0d\u30d8\u30c3\u30c9\u30fb\u30ad\u30e3\u30ce\u30f3\u300d\u306b\u306a\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u300c\uff39\uff0d\u30c8\u30e9\u30a4\u30a2\u30eb\u30fb\u30c9\u30e9\u30b4\u30f3\u300d\u307e\u305f\u306f\u300c\uff3a\uff0d\u30c8\u30e9\u30a4\u30a2\u30eb\u30fb\u30ad\u30e3\u30bf\u30d4\u30e9\u30fc\u300d\uff11\u4f53\u3092\u9078\u3093\u3067\u624b\u672d\u306b\u52a0\u3048\u308b\u4e8b\u304c\u3067\u304d\u308b\u3002\u3053\u306e\u52b9\u679c\u306e\u767a\u52d5\u5f8c\u3001\u30bf\u30fc\u30f3\u7d42\u4e86\u6642\u307e\u3067\u81ea\u5206\u306f\uff25\uff38\u30c7\u30c3\u30ad\u304b\u3089\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5149\u5c5e\u6027\u4ee5\u5916\uff09\u3092\u7279\u6b8a\u53ec\u559a\u3067\u304d\u306a\u3044\u3002", "ko": "\uc774 \uce74\ub4dc\uc758 \uce74\ub4dc\uba85\uc740 \uc774 \ud134\uc5d0, \"X\uff0d\ud5e4\ub4dc \uce90\ub17c\"\uc774 \ub41c\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0 \ubb18\uc9c0\uc758 \"Y\uff0d\ud2b8\ub77c\uc774\uc5bc \ub4dc\ub798\uace4\" \ub610\ub294 \"Z\uff0d\ud2b8\ub77c\uc774\uc5bc \uce90\ud130\ud544\ub7ec\" 1\uc7a5\uc744 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\uc744 \uc218 \uc788\ub2e4. \uc774 \ud6a8\uacfc\uc758 \ubc1c\ub3d9 \ud6c4, \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0 \uc790\uc2e0\uc740 \uc5d1\uc2a4\ud2b8\ub77c \ub371\uc5d0\uc11c \ubaac\uc2a4\ud130(\ube5b \uc18d\uc131 \uc774\uc678)\ub97c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc5c6\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Machine / Effect", "attribute": "LIGHT", "level": 4, "atk": 1300, "def": 1000, "series": ["XYZ"], "images": [{"index": 1, "image": "XTrialCannon-RDAP03-JP-SR.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP008", "set_name": "Advance Pack: Union Base", "rarities": ["Super Rare", "Secret Rare"]}], "ko": [{"set_number": "RD/AP03-KR008", "set_name": "Advance Pack: Union Base", "rarities": ["Super Rare", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1201202}