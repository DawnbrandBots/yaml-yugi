{"konami_id": 23087, "name": {"en": "Miraculous Swordsman - Buster Blader", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u5947<rt>\u304d</rt></ruby><ruby>\u8de1<rt>\u305b\u304d</rt></ruby>\u306e<ruby>\u6226<rt>\u305b\u3093</rt></ruby><ruby>\u58eb<rt>\u3057</rt></ruby>\uff0d\u30d0\u30b9\u30bf\u30fc\u30fb\u30d6\u30ec\u30a4\u30c0\u30fc", "ja_romaji": "Kiseki no Senshi - Basut\u0101 Bureid\u0101", "ko": "\uae30\uc801\uc758 \uc804\uc0ac\uff0d\ubc84\uc2a4\ud130 \ube14\ub808\uc774\ub354", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "You have 10 or more cards in your Deck during your Main Phase that you Special Summoned this card.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u3092\u7279\u6b8a\u53ec\u559a\u3057\u305f\u81ea\u5206\u30e1\u30a4\u30f3\u30d5\u30a7\u30a4\u30ba\u306b\u3001\u81ea\u5206\u306e\u30c7\u30c3\u30ad\u306e\u30ab\u30fc\u30c9\u304c\uff11\uff10\u679a\u4ee5\u4e0a\u306e\u5834\u5408\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc774 \uce74\ub4dc\ub97c \ud2b9\uc218 \uc18c\ud658\ud55c \uc790\uc2e0 \uba54\uc778 \ud398\uc774\uc988\uc5d0, \uc790\uc2e0 \ub371\uc758 \uce74\ub4dc\uac00 10\uc7a5 \uc774\uc0c1\uc77c \uacbd\uc6b0\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Draw 1 card. Then, you can make this card gain ATK equal to [the total number of Dragon and Warrior Type monsters in both players' Graveyards] x 100 until the end of this turn.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306f\uff11\u679a\u30c9\u30ed\u30fc\u3059\u308b\u3002\u305d\u306e\u5f8c\u3001\u3053\u306e\u30ab\u30fc\u30c9\u306e\u653b\u6483\u529b\u3092\u30bf\u30fc\u30f3\u7d42\u4e86\u6642\u307e\u3067\u3001\uff3b\u304a\u4e92\u3044\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30c9\u30e9\u30b4\u30f3\u65cf\u30fb\u6226\u58eb\u65cf\uff09\u306e\u6570\u306e\u5408\u8a08\uff3d\u00d7\uff11\uff10\uff10\u30a2\u30c3\u30d7\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0\uc740 1\uc7a5 \ub4dc\ub85c\uc6b0\ud55c\ub2e4. \uadf8 \ud6c4, \uc774 \uce74\ub4dc\uc758 \uacf5\uaca9\ub825\uc744 \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0, [\uc11c\ub85c\uc758 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ub4dc\ub798\uace4\uc871\u30fb\uc804\uc0ac\uc871)\uc758 \uc218\uc758 \ud569\uacc4] \u00d7 100 \uc62c\ub9b4 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Warrior / Fusion / Effect", "attribute": "EARTH", "level": 9, "atk": 2600, "def": 2300, "materials": {"en": "\"Buster Blader\" + 1 Level 8 or lower Warrior Type monster", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u300c\u30d0\u30b9\u30bf\u30fc\u30fb\u30d6\u30ec\u30a4\u30c0\u30fc\u300d\uff0b\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff18\u4ee5\u4e0b\uff0f\u6226\u58eb\u65cf\uff09", "ko": "\"\ubc84\uc2a4\ud130 \ube14\ub808\uc774\ub354\" \uff0b \ubaac\uc2a4\ud130(\ub808\ubca8 8 \uc774\ud558 / \uc804\uc0ac\uc871)", "zh-TW": null, "zh-CN": null}, "images": [{"index": 1, "image": "MiraculousSwordsmanBusterBlader-RDORP4-JP-UR.png"}], "sets": {"ja": [{"set_number": "RD/ORP4-JP065", "set_name": "Over Rush Pack 4", "rarities": ["Ultra Rare", "Over Rush Rare"]}], "ko": [{"set_number": "RD/ORP4-KR065", "set_name": "Over Rush Pack 4", "rarities": ["Ultra Rare", "Over Rush Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1179979}