4\ud130(\ube5b \uc18d\uc131) 1\uc7a5\uc744 \uace0\ub974\uace0 \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Spell", "property": "Normal", "series": ["Pliage"], "images": [{"index": 1, "image": "EvolutionoftheStarDragon-RDAP03-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP026", "set_name": "Advance Pack: Union Base", "rarities": ["Common"]}], "ko": [{"set_number": "RD/AP03-KR026", "set_name": "Advance Pack: Union Base", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1203875}