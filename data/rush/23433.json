{"konami_id": 23433, "name": {"en": "Chaos Emperor Dragon - Envoy of the End", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u6df7\u6c8c\u5e1d\u9f8d<rt>\u30ab\u30aa\u30b9\u30fb\u30a8\u30f3\u30da\u30e9\u30fc\u30fb\u30c9\u30e9\u30b4\u30f3</rt></ruby> \uff0d<ruby>\u7d42<rt>\u3057\u3085\u3046</rt></ruby><ruby>\u7109<rt>\u3048\u3093</rt></ruby>\u306e<ruby>\u4f7f<rt>\u3057</rt></ruby><ruby>\u8005<rt>\u3057\u3083</rt></ruby>\uff0d", "ja_romaji": null, "ko": "\uce74\uc624\uc2a4 \uc5e0\ud398\ub7ec \ub4dc\ub798\uace4 \uff0d\uc885\uc5b8\uff0d", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "summoning_condition": {"en": "You can Special Summon this card from your hand face-up to your field by placing 1 LIGHT Attribute and 1 DARK Attribute monster from your Graveyard on the bottom of the Deck in any order.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5149\u5c5e\u6027\u30fb\u95c7\u5c5e\u6027\uff09\u3092\uff11\u4f53\u305a\u3064\u597d\u304d\u306a\u9806\u756a\u3067\u30c7\u30c3\u30ad\u306e\u4e0b\u306b\u623b\u3057\u3001\u3053\u306e\u30ab\u30fc\u30c9\u306f\u624b\u672d\u304b\u3089\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ube5b \uc18d\uc131\u30fb\uc5b4\ub460 \uc18d\uc131)\ub97c 1\uc7a5\uc529 \uc88b\uc544\ud558\ub294 \uc21c\uc11c\ub300\ub85c \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9ac\uace0, \uc774 \uce74\ub4dc\ub294 \ud328\uc5d0\uc11c \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "requirement": {"en": "If you have not activated any effect during the turn you Special Summoned this card in the above way, pay 1000 LP.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u4e0a\u8a18\u306e\u65b9\u6cd5\u3067\u3053\u306e\u30ab\u30fc\u30c9\u3092\u7279\u6b8a\u53ec\u559a\u3057\u305f\u30bf\u30fc\u30f3\u306b\u3001\u81ea\u5206\u304c\u52b9\u679c\u3092\u767a\u52d5\u3057\u3066\u3044\u306a\u3044\u5834\u5408\u3001\uff11\uff10\uff10\uff10\uff2c\uff30\u3092\u6255\u3063\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc0c1\uae30\uc758 \ubc29\ubc95\uc73c\ub85c \uc774 \uce74\ub4dc\ub97c \ud2b9\uc218 \uc18c\ud658\ud55c \ud134\uc5d0, \uc790\uc2e0\uc774 \ud6a8\uacfc\ub97c \ubc1c\ub3d9\ud558\uace0 \uc788\uc9c0 \uc54a\uc744 \uacbd\uc6b0, 1000 LP\ub97c \uc9c0\ubd88\ud558\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Send all cards in both players' hands and fields to the Graveyard. Then, inflict damage to your opponent equal to [the number of cards sent to their Graveyard by this effect] x 300.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u304a\u4e92\u3044\u306e\u624b\u672d\u30fb\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u30ab\u30fc\u30c9\u3092\u5168\u3066\u5893\u5730\u3078\u9001\u308b\u3002\u305d\u306e\u5f8c\u3001\uff3b\u3053\u306e\u52b9\u679c\u3067\u76f8\u624b\u306e\u5893\u5730\u3078\u9001\u3089\u308c\u305f\u30ab\u30fc\u30c9\u306e\u6570\uff3d\u00d7\uff13\uff10\uff10\u30c0\u30e1\u30fc\u30b8\u3092\u76f8\u624b\u306b\u4e0e\u3048\u308b\u3002", "ko": "\uc11c\ub85c\uc758 \ud328 / \ud544\ub4dc\uc758 \uce74\ub4dc\ub97c \uc804\ubd80 \ubb18\uc9c0\ub85c \ubcf4\ub0b8\ub2e4. \uadf8 \ud6c4, [\uc774 \ud6a8\uacfc\ub85c \uc0c1\ub300 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uc9c4 \uce74\ub4dc\uc758 \uc218] \u00d7 300 \ub370\ubbf8\uc9c0\ub97c \uc0c1\ub300\uc5d0\uac8c \uc900\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Dragon / Effect", "attribute": "DARK", "level": 8, "atk": 3000, "def": 2500, "legend": true, "images": [{"index": 1, "image": "ChaosEmperorDragonEnvoyoftheEnd-RDAP03-JP-UR.png"}, {"index": 2, "image": "ChaosEmperorDragonEnvoyoftheEnd-RDAP03-JP-FORR.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP001", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Full Over Rush Rare"]}], "ko": [{"set_number": "RD/AP03-KR001", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Full Over Rush Rare"]}]}, "is_translation_unofficial": {"text": {"en": true}}, "yugipedia_page_id": 1201970}