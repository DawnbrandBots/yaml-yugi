{"konami_id": 23208, "name": {"en": "Reporter Lilim", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u5831<rt>\u307b\u3046</rt></ruby><ruby>\u9053<rt>\u3069\u3046</rt></ruby><ruby>\u9b54<rt>\u307e</rt></ruby><ruby>\u5b22<rt>\u3058\u3087\u3046</rt></ruby>\u30ad\u30e3\u30b9\u30bf\u30ea\u30f3", "ja_romaji": "H\u014dd\u014dmaj\u014d Kyasutarin", "ko": "\ubcf4\ub3c4\ub9c8\uc591 \uce90\uc2a4\ud0c0\ub9b0", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Declare a card type (Monster, Spell, or Trap).", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30ab\u30fc\u30c9\u306e\u7a2e\u985e\uff08\u30e2\u30f3\u30b9\u30bf\u30fc\u30fb\u9b54\u6cd5\u30fb\u7f60\uff09\u3092\u5ba3\u8a00\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uce74\ub4dc\uc758 \uc885\ub958(\ubaac\uc2a4\ud130\u30fb\ub9c8\ubc95\u30fb\ud568\uc815)\ub97c \uc120\uc5b8\ud558\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Your opponent excavates the top card of their Deck and places it on top of their Deck. If it was the declared card type, you can draw 1 card. If you do, you cannot activate the effect of \"Reporter Lilim\" this turn.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u306f\u81ea\u8eab\u306e\u30c7\u30c3\u30ad\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u3092\u3081\u304f\u308a\u3001\u304a\u4e92\u3044\u306b\u78ba\u8a8d\u3057\u3066\u5143\u306b\u623b\u3059\u3002\u305d\u306e\u30ab\u30fc\u30c9\u304c\u5ba3\u8a00\u3057\u305f\u7a2e\u985e\u306e\u30ab\u30fc\u30c9\u3060\u3063\u305f\u5834\u5408\u3001\u81ea\u5206\u306f\uff11\u679a\u30c9\u30ed\u30fc\u3067\u304d\u308b\u3002\u30c9\u30ed\u30fc\u3057\u305f\u5834\u5408\u3001\u3053\u306e\u30bf\u30fc\u30f3\u3001\u81ea\u5206\u306f\u300c\u5831\u9053\u9b54\u5b22\u30ad\u30e3\u30b9\u30bf\u30ea\u30f3\u300d\u306e\u52b9\u679c\u3092\u767a\u52d5\u3067\u304d\u306a\u3044\u3002", "ko": "\uc0c1\ub300\ub294 \uc790\uc2e0\uc758 \ub371 \ub9e8 \uc704\uc758 \uce74\ub4dc\ub97c \ub118\uaca8, \uc11c\ub85c \ud655\uc778\ud558\uace0 \uc6d0\ub798\ub300\ub85c \ub418\ub3cc\ub9b0\ub2e4. \uadf8 \uce74\ub4dc\uac00 \uc120\uc5b8\ud55c \uc885\ub958\uc758 \uce74\ub4dc\uc600\uc744 \uacbd\uc6b0, \uc790\uc2e0\uc740 1\uc7a5 \ub4dc\ub85c\uc6b0\ud560 \uc218 \uc788\ub2e4. \ub4dc\ub85c\uc6b0\ud588\uc744 \uacbd\uc6b0, \uc774 \ud134\uc5d0, \uc790\uc2e0\uc740 \"\ubcf4\ub3c4\ub9c8\uc591 \uce90\uc2a4\ud0c0\ub9b0\"\uc758 \ud6a8\uacfc\ub97c \ubc1c\ub3d9\ud560 \uc218 \uc5c6\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Machine / Effect", "attribute": "EARTH", "level": 4, "atk": 1300, "def": 1100, "series": ["Reporter"], "images": [{"index": 1, "image": "ReporterLilim-RDKP25-JP-SR.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP011", "set_name": "Rising of the Aurora", "rarities": ["Super Rare", "Secret Rare"]}], "ko": [{"set_number": "RD/KP25-KR011", "set_name": "Rising of the Aurora", "rarities": ["Super Rare", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1184135}