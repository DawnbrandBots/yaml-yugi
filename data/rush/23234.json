{"konami_id": 23234, "name": {"en": "M\u00e4ssig Anglurr", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30de\u30c3\u30b7\u30b0\u30fb\u30cb\u30e3\u30f3\u30b0\u30e9\u30fc", "ja_romaji": "Masshigu Nyangur\u0101", "ko": "\ub9e5\uc2dc\uadf8 \ub0e5\uae00\ub7ec", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "During the turn you Normal Summoned this card.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u3092\u53ec\u559a\u3057\u305f\u30bf\u30fc\u30f3\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc774 \uce74\ub4dc\ub97c \uc77c\ubc18 \uc18c\ud658\ud55c \ud134\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Send the top 2 cards of either player's Deck to the Graveyard. Then, you can Special Summon 1 Level 6 or lower monster from your opponent's Graveyard to your field in face-up Defense Position. If it is the first turn of the player going second, you can Special Summon a Level 7 or higher monster from your opponent's Graveyard instead.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u307e\u305f\u306f\u76f8\u624b\u306e\u30c7\u30c3\u30ad\u306e\u4e0a\u304b\u3089\u30ab\u30fc\u30c9\uff12\u679a\u3092\u5893\u5730\u3078\u9001\u308b\u3002\u305d\u306e\u5f8c\u3001\u76f8\u624b\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff16\u4ee5\u4e0b\uff09\uff11\u4f53\u3092\u9078\u3093\u3067\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u5b88\u5099\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3067\u304d\u308b\u3002\u3053\u306e\u30bf\u30fc\u30f3\u304c\u5f8c\u653b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6700\u521d\u306e\u30bf\u30fc\u30f3\u306e\u5834\u5408\u3001\u3053\u306e\u52b9\u679c\u3067\u76f8\u624b\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff17\u4ee5\u4e0a\uff09\u3092\u9078\u3076\u4e8b\u3082\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0 \ub610\ub294 \uc0c1\ub300\uc758 \ub371 \uc704\uc5d0\uc11c \uce74\ub4dc 2\uc7a5\uc744 \ubb18\uc9c0\ub85c \ubcf4\ub0b8\ub2e4. \uadf8 \ud6c4, \uc0c1\ub300 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ub808\ubca8 6 \uc774\ud558) 1\uc7a5\uc744 \uace0\ub974\uace0 \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \uc218\ube44 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4. \uc774 \ud134\uc774 \ud6c4\uacf5 \ud50c\ub808\uc774\uc5b4\uc758 \ucd5c\ucd08\uc758 \ud134\uc77c \uacbd\uc6b0, \uc774 \ud6a8\uacfc\ub85c \uc0c1\ub300 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ub808\ubca8 7 \uc774\uc0c1)\ub97c \uace0\ub97c \uc218\ub3c4 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Fish / Effect", "attribute": "WATER", "level": 4, "atk": 1400, "def": 500, "images": [{"index": 1, "image": "M\u00e4ssigAnglurr-RDKP25-JP-UR.png", "illustration": "M\u00e4ssigAnglurr-OW.png"}, {"index": 2, "image": "M\u00e4ssigAnglurr-RDKP25-JP-ORR-AA.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP037", "set_name": "Rising of the Aurora", "rarities": ["Ultra Rare", "Secret Rare", "Over Rush Rare"]}], "ko": [{"set_number": "RD/KP25-KR037", "set_name": "Rising of the Aurora", "rarities": ["Ultra Rare", "Secret Rare", "Over Rush Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1184122}