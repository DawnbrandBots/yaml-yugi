{"konami_id": 23053, "name": {"en": "Spiritualization Training", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u970a<rt>\u308c\u3044</rt></ruby><ruby>\u4f53<rt>\u305f\u3044</rt></ruby><ruby>\u5316<rt>\u304b</rt></ruby>\u306e<ruby>\u935b<rt>\u305f\u3093</rt></ruby><ruby>\u932c<rt>\u308c\u3093</rt></ruby>", "ja_romaji": "Reitaika no Tanren", "ko": "\ub839\uccb4\ud654\uc758 \ub2e8\ub828", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "During a turn you have not activated \"Spiritualization Training\", reveal 2 monsters with the same Attribute in your hand.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u304c\u300c\u970a\u4f53\u5316\u306e\u935b\u932c\u300d\u3092\u767a\u52d5\u3057\u3066\u3044\u306a\u3044\u30bf\u30fc\u30f3\u306b\u3001\u624b\u672d\u306e\u540c\u3058\u5c5e\u6027\u3092\u6301\u3064\u30e2\u30f3\u30b9\u30bf\u30fc\uff12\u4f53\u3092\u76f8\u624b\u306b\u898b\u305b\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0\uc774 \"\ub839\uccb4\ud654\uc758 \ub2e8\ub828\"\uc744 \ubc1c\ub3d9\ud558\uace0 \uc788\uc9c0 \uc54a\uc740 \ud134\uc5d0, \ud328\uc758 \uac19\uc740 \uc18d\uc131\uc744 \uac00\uc9c0\ub294 \ubaac\uc2a4\ud130 2\uc7a5\uc744 \uc0c1\ub300\uc5d0\uac8c \ubcf4\uc5ec\uc8fc\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Add 1 Spellcaster Type monster with 500 or 1900 ATK/1500 DEF, and/or 1 Level 4 monster with 1500 ATK/200 DEF, with the same Attribute as the monsters revealed to meet the requirement from your Graveyard to your hand.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u52b9\u679c\u306e\u6761\u4ef6\u3067\u898b\u305b\u305f\u30e2\u30f3\u30b9\u30bf\u30fc\u3068\u540c\u3058\u5c5e\u6027\u3092\u6301\u3064\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u9b54\u6cd5\u4f7f\u3044\u65cf\uff0f\u653b\u6483\u529b\uff15\uff10\uff10\u30fb\uff11\uff19\uff10\uff10\uff0f\