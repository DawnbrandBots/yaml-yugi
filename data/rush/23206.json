{"konami_id": 23206, "name": {"en": "Reporter Wars Scoopies [R]", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u5831<rt>\u307b\u3046</rt></ruby><ruby>\u9053<rt>\u3069\u3046</rt></ruby><ruby>\u5408<rt>\u304b\u3063</rt></ruby><ruby>\u6226<rt>\u305b\u3093</rt></ruby>\u30b9\u30af\u30fc\u30d4\u30fc\u30ba\uff3b<ruby>\uff32<rt>\u30a2\u30fc\u30eb</rt></ruby>\uff3d", "ja_romaji": "H\u014dd\u014dgassen Suk\u016bp\u012bzu [\u0100ru]", "ko": "\ubcf4\ub3c4\ud569\uc804 \uc2a4\ucfe0\ud53c\uc988[R]", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "You have 10 or more cards in your Deck.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u30c7\u30c3\u30ad\u306e\u30ab\u30fc\u30c9\u304c\uff11\uff10\u679a\u4ee5\u4e0a\u306e\u5834\u5408\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0 \ub371\uc758 \uce74\ub4dc\uac00 10\uc7a5 \uc774\uc0c1\uc77c \uacbd\uc6b0\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Your opponent excavates the top card of their Deck and places it on top of their Deck. If it was a Monster Card, send the top 3 cards of your Deck to the Graveyard. Then, if this card is in Maximum Mode, you can place up to 2 \"Hot Off the Press\" from your Graveyard on top of the Deck in any order.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u306f\u81ea\u8eab\u306e\u30c7\u30c3\u30ad\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u3092\u3081\u304f\u308a\u3001\u304a\u4e92\u3044\u306b\u78ba\u8a8d\u3057\u3066\u5143\u306b\u623b\u3059\u3002\u305d\u306e\u30ab\u30fc\u30c9\u304c\u30e2\u30f3\u30b9\u30bf\u30fc\u3060\u3063\u305f\u5834\u5408\u3001\u81ea\u5206\u306f\u81ea\u5206\u306e\u30c7\u30c3\u30ad\u306e\u4e0a\u304b\u3089\u30ab\u30fc\u30c9\uff13\u679a\u3092\u5893\u5730\u3078\u9001\u308b\u3002\u3053\u306e\u30ab\u30fc\u30c9\u304c\u30de\u30ad\u30b7\u30de\u30e0\u30e2\u30fc\u30c9\u306e\u5834\u5408\u3001\u3055\u3089\u306b\u81ea\u5206\u306e\u5893\u5730\u306e\u300c\u74e6\u30d0\u30fc\u30f3\u300d\u3092\uff12\u679a\u307e\u3067\u9078\u3093\u3067\u597d\u304d\u306a\u9806\u756a\u3067\u30c7\u30c3\u30ad\u306e\u4e0a\u306b\u623b\u3059\u4e8b\u304c\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300\ub294 \uc790\uc2e0\uc758 \ub371 \ub9e8 \uc704\uc758 \uce74\ub4dc\ub97c \ub118\uaca8, \uc11c\ub85c \ud655\uc778\ud558\uace0 \uc6d0\ub798\ub300\ub85c \ub418\ub3cc\ub9b0\ub2e4. \uadf8 \uce74\ub4dc\uac00 \ubaac\uc2a4\ud130\uc600\uc744 \uacbd\uc6b0, \uc790\uc2e0\uc740 \uc790\uc2e0\uc758 \ub371 \uc704\uc5d0\uc11c \uce74\ub4dc 3\uc7a5\uc744 \ubb18\uc9c0\ub85c \ubcf4\ub0b8\ub2e4. \uc774 \uce74\ub4dc\uac00 \ub9e5\uc2dc\uba48 \ubaa8\ub4dc\uc77c \uacbd\uc6b0, \ucd94\uac00\ub85c \uc790\uc2e0 \ubb18\uc9c0\uc758 \"\uae30\uc640 \ubc88\"\uc744 2\uc7a5\uae4c\uc9c0 \uace0\ub974\uace0 \uc88b\uc544\ud558\ub294 \uc21c\uc11c\ub300\ub85c \ub371 \uc704\ub85c \ub418\ub3cc\ub9b4 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Machine / Maximum / Effect", "attribute": "EARTH", "level": 4, "atk": 900, "def": 0, "series": ["Reporter"], "images": [{"index": 1, "image": "ReporterWarsScoopiesR-RDKP25-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP009", "set_name": "Rising of the Aurora", "rarities": ["Common"]}], "ko": [{"set_number": "RD/KP25-KR009", "set_name": "Rising of the Aurora", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1188001}