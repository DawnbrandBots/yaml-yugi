{"konami_id": 23248, "name": {"en": "Loot from the Clad Dragondom", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u7e8f<rt>\u3066\u3093</rt></ruby><ruby>\u7adc<rt>\u308a\u3085\u3046</rt></ruby><ruby>\u57df<rt>\u3044\u304d</rt></ruby>\u306e<ruby>\u6226<rt>\u305b\u3093</rt></ruby><ruby>\u5229<rt>\u308a</rt></ruby><ruby>\u54c1<rt>\u3072\u3093</rt></ruby>", "ja_romaji": "Tenry\u016biki no Senrihin", "ko": "\uc804\ub8e1\uc5ed\uc758 \uc804\ub9ac\ud488", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Send 1 Wyrm Type monster from your hand or 1 face-up Wyrm Type monster from your field to the Graveyard.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u624b\u672d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5e7b\u7adc\u65cf\uff09\u307e\u305f\u306f\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u8868\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5e7b\u7adc\u65cf\uff09\uff11\u4f53\u3092\u5893\u5730\u3078\u9001\u3063\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\ud328\uc758 \ubaac\uc2a4\ud130(\ud658\ub8e1\uc871) \ub610\ub294 \uc790\uc2e0 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130(\ud658\ub8e1\uc871) 1\uc7a5\uc744 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Draw 1 card and show it. If that card is a Wyrm Type monster, you can Special Summon 1 Level 7 or higher Wyrm Type monster from your hand face-up to your field.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306f\uff11\u679a\u30c9\u30ed\u30fc\u3057\u3001\u304a\u4e92\u3044\u306b\u78ba\u8a8d\u3059\u308b\u3002\u305d\u306e\u30ab\u30fc\u30c9\u304c\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5e7b\u7adc\u65cf\uff09\u3060\u3063\u305f\u5834\u5408\u3001\u3055\u3089\u306b\u624b\u672d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff17\u4ee5\u4e0a\uff0f\u5e7b\u7adc\u65cf\uff09\uff11\u4f53\u3092\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0\uc740 1\uc7a5 \ub4dc\ub85c\uc6b0\ud558\uace0, \uc11c\ub85c \ud655\uc778\ud55c\ub2e4. \uadf8 \uce74\ub4dc\uac00 \ubaac\uc2a4\ud130(\ud658\ub8e1\uc871)\uc600\uc744 \uacbd\uc6b0, \ucd94\uac00\ub85c \ud328\uc758 \ubaac\uc2a4\ud130(\ub808\ubca8 7 \uc774\uc0c1 / \ud658\ub8e1\uc871) 1\uc7a5\uc744 \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Spell", "property": "Normal", "series": ["Clad Dragon"], "images": [{"index": 1, "image": "LootfromtheCladDragondom-RDKP25-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP051", "set_name": "Rising of the Aurora", "rarities": ["Common"]}], "ko": [{"set_number": "RD/KP25-KR051", "set_name": "Rising of the Aurora", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1184171}