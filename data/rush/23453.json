{"konami_id": 23453, "name": {"en": "Encounter of the Stars", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u661f<rt>\u307b\u3057</rt></ruby>\u306e<ruby>\u51fa<rt>\u3067</rt></ruby><ruby>\u4f1a<rt>\u3042</rt></ruby>\u3044", "ja_romaji": "Hoshi no Deai", "ko": "\ubcc4\uc758 \ub9cc\ub0a8", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "During a turn you have not activated \"Encounter of the Stars\".", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u304c\u300c\u661f\u306e\u51fa\u4f1a\u3044\u300d\u3092\u767a\u52d5\u3057\u3066\u3044\u306a\u3044\u30bf\u30fc\u30f3\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0\uc774 \"\ubcc4\uc758 \ub9cc\ub0a8\"\uc744 \ubc1c\ub3d9\ud558\uace0 \uc788\uc9c0 \uc54a\uc740 \ud134\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Excavate the top 6 cards of your Deck. You can add 1 excavated Level 2 DARK Attribute monster with 1200 DEF, \"Star Replete\", or \"Fusion\" to your hand. Place the other cards on the bottom of your Deck in any order.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u30c7\u30c3\u30ad\u306e\u4e0a\u304b\u3089\u30ab\u30fc\u30c9\u3092\uff16\u679a\u3081\u304f\u308a\u3001\u304a\u4e92\u3044\u306b\u78ba\u8a8d\u3059\u308b\u3002\u81ea\u5206\u306f\u305d\u306e\u4e2d\u304b\u3089\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff12\uff0f\u95c7\u5c5e\u6027\uff0f\u5b88\u5099\u529b\uff11\uff12\uff10\uff10\uff09\u3001\u300c\u30b9\u30bf\u30fc\u30fb\u30ea\u30d7\u30ea\u30fc\u30c8\u300d\u3001\u300c\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u300d\u306e\u3044\u305a\u308c\u304b\uff11\u679a\u3092\u9078\u3093\u3067\u624b\u672d\u306b\u52a0\u3048\u308b\u4e8b\u304c\u3067\u304d\u308b\u3002\u6b8b\u308a\u306e\u30ab\u30fc\u30c9\u3092\u597d\u304d\u306a\u9806\u756a\u3067\u30c7\u30c3\u30ad\u306e\u4e0b\u306b\u623b\u3059\u3002", "ko": "\uc790\uc2e0\uc758 \ub371 \uc704\uc5d0\uc11c \uce74\ub4dc\ub97c 6\uc7a5 \ub118\uae30\uace0, \uc11c\ub85c \ud655\uc778\ud55c\ub2e4. \uc790\uc2e0\uc740 \uadf8 \uc911\uc5d0\uc11c \ubaac\uc2a4\ud130(\ub808\ubca8 2 / \uc5b4\ub460 \uc18d\uc131 / \uc218\ube44\ub825 1200), \"\uc2a4\ud0c0 \ub9ac\ud50c\ub9ac\ud2b8\", \"\ud4e8\uc804\" \uc911 \uc5b4\ub290 1\uc7a5\uc744 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\uc744 \uc218 \uc788\ub2e4. \ub0a8\uc740 \uce74\ub4dc\ub97c \uc88b\uc544\ud558\ub294 \uc21c\uc11c\ub300\ub85c \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9b0\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Spell", "property": "Normal", "series": ["Pliage"], "images": [{"index": 1, "image": "EncounteroftheStars-RDAP03-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP025", "set_name": "Advance Pack: Union Base", "rarities": ["Common", "Secret Rare"]}], "ko": [{"set_number": "RD/AP03-KR025", "set_name": "Advance Pack: Union Base", "rarities": ["Common", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1201212}