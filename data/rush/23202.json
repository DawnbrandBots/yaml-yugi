{"konami_id": 23202, "name": {"en": "Vanishing Solitius", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30d0\u30cb\u30b7\u30f3\u30b0\u30fb\u30bd\u30ea\u30c6\u30a3\u30a6\u30b9", "ja_romaji": "Banishingu Soritiusu", "ko": "\ubc84\ub2c8\uc2f1 \uc194\ub9ac\ud2f0\uc6b0\uc2a4", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Send the top card of your Deck to the Graveyard.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30c7\u30c3\u30ad\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u3092\u5893\u5730\u3078\u9001\u3063\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\ub371 \ub9e8 \uc704\uc758 \uce74\ub4dc\ub97c \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "This turn, this card's name becomes \"Vanishing Heliacal Riser\". Then, you can add 1 \"Fusion\" or 1 Field Spell Card from your Graveyard to your hand. If you do, you cannot activate the effect of \"Vanishing Solitius\" this turn.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u306e\u30ab\u30fc\u30c9\u540d\u306f\u3053\u306e\u30bf\u30fc\u30f3\u3001\u300c\u30d0\u30cb\u30b7\u30f3\u30b0\u30fb\u30d8\u30ea\u30a2\u30ab\u30eb\u30e9\u30a4\u30b6\u30fc\u300d\u306b\u306a\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u300c\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u300d\u307e\u305f\u306f\u30d5\u30a3\u30fc\u30eb\u30c9\u9b54\u6cd5\u30ab\u30fc\u30c9\uff11\u679a\u3092\u9078\u3093\u3067\u624b\u672d\u306b\u52a0\u3048\u308b\u4e8b\u304c\u3067\u304d\u308b\u3002\u52a0\u3048\u305f\u5834\u5408\u3001\u3053\u306e\u30bf\u30fc\u30f3\u3001\u81ea\u5206\u306f\u300c\u30d0\u30cb\u30b7\u30f3\u30b0\u30fb\u30bd\u30ea\u30c6\u30a3\u30a6\u30b9\u300d\u306e\u52b9\u679c\u3092\u767a\u52d5\u3067\u304d\u306a\u3044\u3002", "ko": "\uc774 \uce74\ub4dc\uc758 \uce74\ub4dc\uba85\uc740 \uc774 \ud134\uc5d0, \"\ubc84\ub2c8\uc2f1 \ud5ec\ub9ac\uc5b4\uceec\ub77c\uc774\uc800\"\uac00 \ub41c\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0 \ubb18\uc9c0\uc758 \"\ud4e8\uc804\" \ub610\ub294 \ud544\ub4dc \ub9c8\ubc95 \uce74\ub4dc 1\uc7a5\uc744 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\uc744 \uc218 \uc788\ub2e4. \ub123\uc5c8\uc744 \uacbd\uc6b0, \uc774 \ud134\uc5d0, \uc790\uc2e0\uc740 \"\ubc84\ub2c8\uc2f1 \uc194\ub9ac\ud2f0\uc6b0\uc2a4\"\uc758 \ud6a8\uacfc\ub97c \ubc1c\ub3d9\ud560 \uc218 \uc5c6\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Galaxy / Effect", "attribute": "LIGHT", "level": 6, "atk": 1700, "def": 1500, "images": [{"index": 1, "image": "VanishingSolitius-RDKP25-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP005", "set_name": "Rising of the Aurora", "rarities": ["Common"]}], "ko": [{"set_number": "RD/KP25-KR005", "set_name": "Rising of the Aurora", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1184150}