{"konami_id": 23201, "name": {"en": "Civil Twirider", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30b7\u30d3\u30eb\u30fb\u30c8\u30ef\u30a4\u30e9\u30a4\u30c0\u30fc", "ja_romaji": "Shibiru Towairaid\u0101", "ko": "\uc2dc\ube4c \ud2b8\uc640\uc77c\ub77c\uc774\ub354", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Shuffle 2 Galaxy Type monsters from your Graveyard into the Deck.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ae\u30e3\u30e9\u30af\u30b7\u30fc\u65cf\uff09\uff12\u4f53\u3092\u30c7\u30c3\u30ad\u306b\u623b\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\uac24\ub7ed\uc2dc\uc871) 2\uc7a5\uc744 \ub371\uc73c\ub85c \ub418\ub3cc\ub9ac\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "This turn, this face-up card can be treated as 2 Tributes for the Tribute Summon of a LIGHT Attribute Galaxy Type monster in Attack Position. Then, you can add 1 \"Galactica Oblivion\" or \"Vanishing Heliacal Riser\" from your Graveyard to your hand.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30bf\u30fc\u30f3\u3001\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5149\u5c5e\u6027\uff0f\u30ae\u30e3\u30e9\u30af\u30b7\u30fc\u65cf\uff09\u3092\u653b\u6483\u8868\u793a\u3067\u30a2\u30c9\u30d0\u30f3\u30b9\u53ec\u559a\u3059\u308b\u5834\u5408\u3001\u8868\u5074\u8868\u793a\u306e\u3053\u306e\u30ab\u30fc\u30c9\u306f\uff12\u4f53\u5206\u306e\u30ea\u30ea\u30fc\u30b9\u306b\u3067\u304d\u308b\u3002\u3055\u3089\u306b\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u300c\u30ae\u30e3\u30e9\u30af\u30c6\u30a3\u30ab\u30fb\u30aa\u30d6\u30ea\u30d3\u30aa\u30f3\u300d\u307e\u305f\u306f\u300c\u30d0\u30cb\u30b7\u30f3\u30b0\u30fb\u30d8\u30ea\u30a2\u30ab\u30eb\u30e9\u30a4\u30b6\u30fc\u300d\uff11\u4f53\u3092\u9078\u3093\u3067\u624b\u672d\u306b\u52a0\u3048\u308b\u4e8b\u304c\u3067\u304d\u308b\u3002", "ko": "\uc774 \ud134\uc5d0, \ubaac\uc2a4\ud130(\ube5b \uc18d\uc131 / \uac24\ub7ed\uc2dc\uc871)\ub97c \uacf5\uaca9 \ud45c\uc2dc\ub85c \uc5b4\ub4dc\ubc34\uc2a4 \uc18c\ud658\ud560 \uacbd\uc6b0, \uc55e\uba74 \ud45c\uc2dc\uc778 \uc774 \uce74\ub4dc\ub294 2\uc7a5\ub9cc\ud07c\uc758 \ub9b4\ub9ac\uc2a4\ub85c \ud560 \uc218 \uc788\ub2e4. \ucd94\uac00\ub85c, \uc790\uc2e0 \ubb18\uc9c0\uc758 \"\uac24\ub7ed\ud2f0\uce74 \uc624\ube14\ub9ac\ube44\uc5b8\" \ub610\ub294 \"\ubc84\ub2c8\uc2f1 \ud5ec\ub9ac\uc5b4\uceec\ub77c\uc774\uc800\" 1\uc7a5\uc744 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\uc744 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Galaxy / Effect", "attribute": "LIGHT", "level": 4, "atk": 900, "def": 1200, "images": [{"index": 1, "image": "CivilTwirider-RDKP25-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP004", "set_name": "Rising of the Aurora", "rarities": ["Common"]}], "ko": [{"set_number": "RD/KP25-KR004", "set_name": "Rising of the Aurora", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1185734}