{"konami_id": 23075, "name": {"en": "Skysavior Aspiration", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u84bc<rt>\u305d\u3046</rt></ruby><ruby>\u6551<rt>\u304d\u3085\u3046</rt></ruby>\u306e<ruby>\u5bbf<rt>\u3057\u3085\u304f</rt></ruby><ruby>\u9858<rt>\u304c\u3093</rt></ruby>", "ja_romaji": "S\u014dky\u016b no Shukugan", "ko": "\ucc3d\uad6c\uc758 \uc219\uc6d0", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Send 1 non-Legend Warrior or Fairy Type monster or 1 \"Fusion\" from your hand to the Graveyard.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30ec\u30b8\u30a7\u30f3\u30c9\u30ab\u30fc\u30c9\u4ee5\u5916\u306e\u624b\u672d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u6226\u58eb\u65cf\u30fb\u5929\u4f7f\u65cf\uff09\uff11\u4f53\u307e\u305f\u306f\u300c\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u300d\uff11\u679a\u3092\u5893\u5730\u3078\u9001\u3063\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\ub808\uc804\ub4dc \uce74\ub4dc \uc774\uc678\uc758 \ud328\uc758 \ubaac\uc2a4\ud130(\uc804\uc0ac\uc871\u30fb\ucc9c\uc0ac\uc871) 1\uc7a5 \ub610\ub294 \"\ud4e8\uc804\" 1\uc7a5\uc744 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Draw 2 cards. Until the end of this turn, you cannot Special Summon non-Celestial Warrior Type monsters from the Extra Deck or attack with Level 8 or lower monsters.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306f\uff12\u679a\u30c9\u30ed\u30fc\u3059\u308b\u3002\u3053\u306e\u52b9\u679c\u306e\u767a\u52d5\u5f8c\u3001\u30bf\u30fc\u30f3\u7d42\u4e86\u6642\u307e\u3067\u81ea\u5206\u306f\uff25\uff38\u30c7\u30c3\u30ad\u304b\u3089\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5929\u754c\u6226\u58eb\u65cf\u4ee5\u5916\uff09\u3092\u7279\u6b8a\u53ec\u559a\u3067\u304d\u305a\u3001\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff18\u4ee5\u4e0b\uff09\u3067\u653b\u6483\u3067\u304d\u306a\u3044\u3002", "ko": "\uc790\uc2e0\uc740 2\uc7a5 \ub4dc\ub85c\uc6b0\ud55c\ub2e4. \uc774 \ud6a8\uacfc\uc758 \ubc1c\ub3d9 \ud6c4, \ud134 \uc885\ub8cc\uc2dc\uae4c\uc9c0 \uc790\uc2e0\uc740 \uc5d1\uc2a4\ud2b8\ub77c \ub371\uc5d0\uc11c \ubaac\uc2a4\ud130(\ucc9c\uacc4\uc804\uc0ac\uc871 \uc774\uc678)\ub97c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc5c6\uc73c\uba70, \ubaac\uc2a4\ud130(\ub808\ubca8 8 \uc774\ud558)\ub85c \uacf5\uaca9\ud560 \uc218 \uc5c6\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Spell", "property": "Normal", "series": ["Skysavior"], "images": [{"index": 1, "image": "SkysaviorAspiration-RDORP4-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/ORP4-JP051", "set_name": "Over Rush Pack 4", "rarities": ["Common"]}], "ko": [{"set_number": "RD/ORP4-KR051", "set_name": "Over Rush Pack 4", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1182730}