{"konami_id": 23262, "name": {"en": "Beacon of the Dark Titan", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u6697<rt>\u3042\u3093</rt></ruby><ruby>\u9ed2<rt>\u3053\u304f</rt></ruby><ruby>\u9b54<rt>\u307e</rt></ruby><ruby>\u795e<rt>\u3058\u3093</rt></ruby>\u306e<ruby>\u5c0e<rt>\u307f\u3061\u3073</rt></ruby>\u304d", "ja_romaji": "Ankokumajin no Michibiki", "ko": "\uc554\ud751 \ub9c8\uc2e0\uc758 \uc778\ub3c4", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "When your opponent Sets a monster from their hand, or when a face-up monster(s) on your opponent's field is flipped face-down.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u304c\u624b\u672d\u304b\u3089\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u30bb\u30c3\u30c8\u3057\u305f\u6642\u3001\u307e\u305f\u306f\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u8868\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\u304c\u88cf\u5074\u8868\u793a\u306b\u306a\u3063\u305f\u6642\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300\uac00 \ud328\uc5d0\uc11c \ubaac\uc2a4\ud130\ub97c \uc138\ud2b8\ud588\uc744 \ub54c, \ub610\ub294 \uc0c1\ub300 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130\uac00 \ub4b7\uba74 \ud45c\uc2dc\uac00 \ub418\uc5c8\uc744 \ub54c\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Look at 1 face-down monster on your opponent's field. Then, if you have a face-up monster with ATK greater than or equal to [that monster's original ATK] on your field, you can destroy the monster you looked at.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u88cf\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\uff11\u4f53\u3092\u9078\u3093\u3067\u78ba\u8a8d\u3059\u308b\u3002\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\uff3b\u305d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u306e\u5143\u3005\u306e\u653b\u6483\u529b\uff3d\u4ee5\u4e0a\u306e\u653b\u6483\u529b\u3092\u6301\u3064\u8868\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\u304c\u3044\u308b\u5834\u5408\u3001\u3055\u3089\u306b\u78ba\u8a8d\u3057\u305f\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u7834\u58ca\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300 \ud544\ub4dc\uc758 \ub4b7\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130 1\uc7a5\uc744 \uace0\ub974\uace0 \ud655\uc778\ud55c\ub2e4. \uc790\uc2e0 \ud544\ub4dc\uc5d0 [\uadf8 \ubaac\uc2a4\ud130\uc758 \uc6d0\ub798 \uacf5\uaca9\ub825] \uc774\uc0c1\uc758 \uacf5\uaca9\ub825\uc744 \uac00\uc9c0\ub294 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130\uac00 \uc788\uc744 \uacbd\uc6b0, \ucd94\uac00\ub85c \ud655\uc778\ud55c \ubaac\uc2a4\ud130\ub97c \ud30c\uad34\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Trap", "property": "Normal", "images": [{"index": 1, "image": "BeaconoftheDarkTitan-RDKP25-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP065", "set_name": "Rising of the Aurora", "rarities": ["Common"]}], "ko": [{"set_number": "RD/KP25-KR065", "set_name": "Rising of the Aurora", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1190302}