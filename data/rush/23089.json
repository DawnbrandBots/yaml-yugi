{"konami_id": 23089, "name": {"en": "Draco the Palm Greaser", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u624b<rt>\u3066</rt></ruby><ruby>\u63c9<rt>\u3082</rt></ruby>\u307f\u30c9\u30e9\u30b3", "ja_romaji": "Temomi Dorako", "ko": "\ud14c\ubaa8\ubbf8 \ub4dc\ub77c\ucf54", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "If you have 2 or more cards in your hand, change this Attack Position card to face-up Defense Position.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u624b\u672d\u304c\uff12\u679a\u4ee5\u4e0a\u306e\u5834\u5408\u3001\u653b\u6483\u8868\u793a\u306e\u3053\u306e\u30ab\u30fc\u30c9\u3092\u8868\u5074\u5b88\u5099\u8868\u793a\u306b\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0\uc758 \ud328\uac00 2\uc7a5 \uc774\uc0c1\uc77c \uacbd\uc6b0, \uacf5\uaca9 \ud45c\uc2dc\uc778 \uc774 \uce74\ub4dc\ub97c \uc55e\uba74 \uc218\ube44 \ud45c\uc2dc\ub85c \ud558\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Your opponent gains 100 LP. Then, reveal 1 random card in your hand. Then, if that card is a Dragon Type monster, you can Special Summon it face-up to your field.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u306f\uff11\uff10\uff10\uff2c\uff30\u56de\u5fa9\u3059\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u624b\u672d\u3092\u30e9\u30f3\u30c0\u30e0\u306b\uff11\u679a\u9078\u3073\u3001\u304a\u4e92\u3044\u306b\u78ba\u8a8d\u3059\u308b\u3002\u305d\u306e\u30ab\u30fc\u30c9\u304c\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30c9\u30e9\u30b4\u30f3\u65cf\uff09\u3060\u3063\u305f\u5834\u5408\u3001\u3055\u3089\u306b\u305d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300\ub294 100 LP \ud68c\ubcf5\ud55c\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0\uc758 \ud328\ub97c \ubb34\uc791\uc704\ub85c 1\uc7a5 \uace0\ub974\uace0, \uc11c\ub85c \ud655\uc778\ud55c\ub2e4. \uadf8 \uce74\ub4dc\uac00 \ubaac\uc2a4\ud130(\ub4dc\ub798\uace4\uc871)\uc600\uc744 \uacbd\uc6b0, \ucd94\uac00\ub85c \uadf8 \ubaac\uc2a4\ud130\ub97c \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Dragon / Effect", "attribute": "DARK", "level": 1, "atk": 0, "def": 1400, "series": ["Draco"], "images": [{"index": 1, "image": "DracothePalmGreaser-RDORP4-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/ORP4-JP067", "set_name": "Over Rush Pack 4", "rarities": ["Common"]}], "ko": [{"set_number": "RD/ORP4-KR067", "set_name": "Over Rush Pack 4", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1178663}