{"konami_id": 23076, "name": {"en": "Skysavior Defense", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u84bc<rt>\u305d\u3046</rt></ruby><ruby>\u6551<rt>\u304d\u3085\u3046</rt></ruby>\u306e<ruby>\u9632<rt>\u307c\u3046</rt></ruby><ruby>\u885b<rt>\u3048\u3044</rt></ruby>", "ja_romaji": "S\u014dky\u016b no B\u014dei", "ko": "\ucc3d\uad6c\uc758 \ubc29\uc704", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "When your opponent Normal or Special Summons a monster, shuffle 2 WATER Attribute Warrior Type monsters from your Graveyard into the Deck.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u304c\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u53ec\u559a\u30fb\u7279\u6b8a\u53ec\u559a\u3057\u305f\u6642\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u6c34\u5c5e\u6027\uff0f\u6226\u58eb\u65cf\uff09\uff12\u4f53\u3092\u30c7\u30c3\u30ad\u306b\u623b\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300\uac00 \ubaac\uc2a4\ud130\ub97c \uc77c\ubc18 \uc18c\ud658 / \ud2b9\uc218 \uc18c\ud658\ud588\uc744 \ub54c, \uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ubb3c \uc18d\uc131 / \uc804\uc0ac\uc871) 2\uc7a5\uc744 \ub371\uc73c\ub85c \ub418\ub3cc\ub9ac\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Choose up to 2 Attack Position Celestial Warrior and/or Warrior Type monsters on your field. This turn, those monsters cannot be destroyed by battle. Then, you can Set 1 \"Fusion\" from your Graveyard to your Spell & Trap Zone.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u653b\u6483\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5929\u754c\u6226\u58eb\u65cf\u30fb\u6226\u58eb\u65cf\uff09\u3092\u5408\u8a08\uff12\u4f53\u307e\u3067\u9078\u3076\u3002\u3053\u306e\u30bf\u30fc\u30f3\u3001\u305d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u306f\u6226\u95d8\u3067\u306f\u7834\u58ca\u3055\u308c\u306a\u3044\u3002\u3055\u3089\u306b\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u300c\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u300d\uff11\u679a\u3092\u9078\u3093\u3067\u81ea\u5206\u306e\u9b54\u6cd5\uff06\u7f60\u30be\u30fc\u30f3\u306b\u30bb\u30c3\u30c8\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0 \ud544\ub4dc\uc758 \uacf5\uaca9 \ud45c\uc2dc \ubaac\uc2a4\ud130(\ucc9c\uacc4\uc804\uc0ac\uc871\u30fb\uc804\uc0ac\uc871)\ub97c \ud569\uacc4 2\uc7a5\uae4c\uc9c0 \uace0\ub978\ub2e4. \uc774 \ud134\uc5d0, \uadf8 \ubaac\uc2a4\ud130\ub294 \uc804\ud22c\ub85c\ub294 \ud30c\uad34\ub418\uc9c0 \uc54a\ub294\ub2e4. \ucd94\uac00\ub85c, \uc790\uc2e0 \ubb18\uc9c0\uc758 \"\ud4e8\uc804\" 1\uc7a5\uc744 \uace0\ub974\uace0 \uc790\uc2e0\uc758 \ub9c8\ubc95 & \ud568\uc815 \uc874\uc5d0 \uc138\ud2b8\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Trap", "property": "Normal", "series": ["Skysavior"], "images": [{"index": 1, "image": "SkysaviorDefense-RDORP4-JP-SR.png"}], "sets": {"ja": [{"set_number": "RD/ORP4-JP054", "set_name": "Over Rush Pack 4", "rarities": ["Super Rare", "Secret Rare"]}], "ko": [{"set_number": "RD/ORP4-KR054", "set_name": "Over Rush Pack 4", "rarities": ["Super Rare", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1176594}