{"konami_id": 23254, "name": {"en": "Beastly Mirror Calling", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u60aa<rt>\u3042\u304f</rt></ruby><ruby>\u9b54<rt>\u307e</rt></ruby><ruby>\u93e1<rt>\u304b\u304c\u307f</rt></ruby>\u306e<ruby>\u62db<rt>\u3057\u3087\u3046</rt></ruby><ruby>\u6765<rt>\u3089\u3044</rt></ruby>", "ja_romaji": "Akumakagami no Sh\u014drai", "ko": "\uc545\ub9c8\uacbd\uc758 \uc18c\ub798", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "None", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u306a\u3057", "ko": "\uc5c6\uc74c", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Ritual Summon \"Fiend's Mirror\" or \"Absorbing Fiend's Mirror\" by sending face-up Fiend Type monsters from your field to the Graveyard whose total Levels equal 6 or more as material (you cannot use more monsters than necessary as material). Then, if you have \"Beastly Mirror Ritual\" in your Graveyard, you can destroy 1 card on your opponent's field.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30ec\u30d9\u30eb\u306e\u5408\u8a08\u304c\uff16\u4ee5\u4e0a\u306b\u306a\u308b\u3088\u3046\u306b\u3001\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u8868\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u60aa\u9b54\u65cf\uff09\u3092\u7d20\u6750\u3068\u3057\u3066\u5893\u5730\u3078\u9001\u308a\u3001\u300c\u30c7\u30d3\u30eb\u30ba\u30fb\u30df\u30e9\u30fc\u300d\u307e\u305f\u306f\u300c\u5438\u53ce\u3059\u308b\u30c7\u30d3\u30eb\u30ba\u30fb\u30df\u30e9\u30fc\u300d\u3092\u30ea\u30c1\u30e5\u30a2\u30eb\u53ec\u559a\u3059\u308b\uff08\u4f59\u5206\u306b\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u7d20\u6750\u306b\u3067\u304d\u306a\u3044\uff09\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u5893\u5730\u306b\u300c\u60aa\u9b54\u93e1\u306e\u5100\u5f0f\u300d\u304c\u3042\u308b\u5834\u5408\u3001\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u30ab\u30fc\u30c9\uff11\u679a\u3092\u9078\u3093\u3067\u7834\u58ca\u3067\u304d\u308b\u3002", "ko": "\ub808\ubca8\uc758 \ud569\uacc4\uac00 6 \uc774\uc0c1\uc774 \ub418\ub3c4\ub85d, \uc790\uc2e0 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130(\uc545\ub9c8\uc871)\ub97c \uc18c\uc7ac\ub85c\uc11c \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0, \"\ub370\ube14\uc988 \ubbf8\ub7ec\" \ub610\ub294 \"\ud761\uc218\ud558\ub294 \ub370\ube14\uc988 \ubbf8\ub7ec\"\ub97c \ub9ac\ucd94\uc5bc \uc18c\ud658\ud55c\ub2e4(\uc5ec\ubd84\uc758 \ubaac\uc2a4\ud130\ub97c \uc18c\uc7ac\ub85c \ud560 \uc218 \uc5c6\ub2e4). \uadf8 \ud6c4, \uc790\uc2e0 \ubb18\uc9c0\uc5d0 \"\uc545\ub9c8\uacbd\uc758 \uc758\uc2dd\"\uc774 \uc788\uc744 \uacbd\uc6b0, \uc0c1\ub300 \ud544\ub4dc\uc758 \uce74\ub4dc 1\uc7a5\uc744 \uace0\ub974\uace0 \ud30c\uad34\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Spell", "property": "Ritual", "series": ["Fiend's"], "images": [{"index": 1, "image": "BeastlyMirrorCalling-RDKP25-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP057", "set_name": "Rising of the Aurora", "rarities": ["Common"]}, {"set_number": "RD/B263-JP006", "set_name": "Battle Bonus Pack 2026 Vol.3", "rarities": ["Super Parallel Rare"]}], "ko": [{"set_number": "RD/KP25-KR057", "set_name": "Rising of the Aurora", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1191467}