{"konami_id": 23440, "name": {"en": "Y-Trial Dragon", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\uff39<rt>\u30ef\u30a4</rt></ruby>\uff0d\u30c8\u30e9\u30a4\u30a2\u30eb\u30fb\u30c9\u30e9\u30b4\u30f3", "ja_romaji": "Wai - Toraiaru Doragon", "ko": "Y\uff0d\ud2b8\ub77c\uc774\uc5bc \ub4dc\ub798\uace4", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Send the top card of your Deck to the Graveyard.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30c7\u30c3\u30ad\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u3092\u5893\u5730\u3078\u9001\u3063\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\ub371 \ub9e8 \uc704\uc758 \uce74\ub4dc\ub97c \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "This turn, this card's name becomes \"Y-Dragon Head\". Then, you can Fusion Summon \"XY-Dragon Cannon\" or \"YZ-Tank Dragon\" by placing monsters from your field or Graveyard on the bottom of the owner's Deck in any order as material, including this card.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u306e\u30ab\u30fc\u30c9\u540d\u306f\u3053\u306e\u30bf\u30fc\u30f3\u3001\u300c\uff39\uff0d\u30c9\u30e9\u30b4\u30f3\u30fb\u30d8\u30c3\u30c9\u300d\u306b\u306a\u308b\u3002\u305d\u306e\u5f8c\u3001\u3053\u306e\u30ab\u30fc\u30c9\u3092\u542b\u3080\u81ea\u5206\u306e\u30d5\u30a3\u30fc\u30eb\u30c9\u30fb\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u7d20\u6750\u3068\u3057\u3066\u597d\u304d\u306a\u9806\u756a\u3067\u6301\u3061\u4e3b\u306e\u30c7\u30c3\u30ad\u306e\u4e0b\u306b\u623b\u3057\u3066\u300c\uff38\uff39\uff0d\u30c9\u30e9\u30b4\u30f3\u30fb\u30ad\u30e3\u30ce\u30f3\u300d\u307e\u305f\u306f\u300c\uff39\uff3a\uff0d\u30ad\u30e3\u30bf\u30d4\u30e9\u30fc\u30fb\u30c9\u30e9\u30b4\u30f3\u300d\u3092\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u53ec\u559a\u3067\u304d\u308b\u3002", "ko": "\uc774 \uce74\ub4dc\uc758 \uce74\ub4dc\uba85\uc740 \uc774 \ud134\uc5d0, \"Y\uff0d\ub4dc\ub798\uace4 \ud5e4\ub4dc\"\uac00 \ub41c\ub2e4. \uadf8 \ud6c4, \uc774 \uce74\ub4dc\ub97c \ud3ec\ud568\ud558\ub294 \uc790\uc2e0\uc758 \ud544\ub4dc / \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130\ub97c \uc18c\uc7ac\ub85c\uc11c \uc88b\uc544\ud558\ub294 \uc21c\uc11c\ub300\ub85c \uc8fc\uc778\uc758 \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9ac\uace0 \"XY\uff0d\ub4dc\ub798\uace4 \uce90\ub17c\" \ub610\ub294 \"YZ\uff0d\uce90\ud130\ud544\ub7ec \ub4dc\ub798\uace4\"\uc744 \ud4e8\uc804 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Machine / Effect", "attribute": "LIGHT", "level": 4, "atk": 1000, "def": 1100, "series": ["XYZ"], "images": [{"index": 1, "image": "YTrialDragon-RDAP03-JP-SR.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP009", "set_name": "Advance Pack: Union Base", "rarities": ["Super Rare", "Secret Rare"]}], "ko": [{"set_number": "RD/AP03-KR009", "set_name": "Advance Pack: Union Base", "rarities": ["Super Rare", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1201204}