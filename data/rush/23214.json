{"konami_id": 23214, "name": {"en": "Shannah the Clad Dragon Researcher", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u7e8f<rt>\u3066\u3093</rt></ruby><ruby>\u7adc<rt>\u308a\u3085\u3046</rt></ruby>\u306e<ruby>\u63a2<rt>\u305f\u3093</rt></ruby><ruby>\u7d22<rt>\u3055\u304f</rt></ruby><ruby>\u8005<rt>\u3057\u3083</rt></ruby> \u30b7\u30e3\u30fc\u30ca", "ja_romaji": "Tenry\u016b no Tansakusha Sh\u0101na", "ko": "\uc804\ub8e1\uc758 \ud0d0\uc0c9\uc790 \uc0e4\ub098", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "If you have 10 or more cards in your Deck, shuffle 2 Wyrm Type monsters from your Graveyard into the Deck.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u30c7\u30c3\u30ad\u306e\u30ab\u30fc\u30c9\u304c\uff11\uff10\u679a\u4ee5\u4e0a\u306e\u5834\u5408\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5e7b\u7adc\u65cf\uff09\uff12\u4f53\u3092\u30c7\u30c3\u30ad\u306b\u623b\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0 \ub371\uc758 \uce74\ub4dc\uac00 10\uc7a5 \uc774\uc0c1\uc77c \uacbd\uc6b0, \uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ud658\ub8e1\uc871) 2\uc7a5\uc744 \ub371\uc73c\ub85c \ub418\ub3cc\ub9ac\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Change 1 face-up monster on your opponent's field to face-down Defense Position. Then, send the top card of your Deck to the Graveyard. Then, if you sent a Wyrm Type monster with 2400 DEF to the Graveyard by this effect, you can add that monster to your hand.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u8868\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\uff11\u4f53\u3092\u9078\u3093\u3067\u88cf\u5074\u5b88\u5099\u8868\u793a\u306b\u3059\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u30c7\u30c3\u30ad\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u3092\u5893\u5730\u3078\u9001\u308b\u3002\u3053\u306e\u52b9\u679c\u3067\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5e7b\u7adc\u65cf\uff0f\u5b88\u5099\u529b\uff12\uff14\uff10\uff10\uff09\u304c\u5893\u5730\u3078\u9001\u3089\u308c\u305f\u5834\u5408\u3001\u3055\u3089\u306b\u305d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u624b\u672d\u306b\u52a0\u3048\u308b\u4e8b\u304c\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130 1\uc7a5\uc744 \uace8\ub77c \ub4b7\uba74 \uc218\ube44 \ud45c\uc2dc\ub85c \ud55c\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0\uc758 \ub371 \ub9e8 \uc704\uc758 \uce74\ub4dc\ub97c \ubb18\uc9c0\ub85c \ubcf4\ub0b8\ub2e4. \uc774 \ud6a8\uacfc\ub85c \ubaac\uc2a4\ud130(\ud658\ub8e1\uc871 / \uc218\ube44\ub825 2400)\uac00 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uc84c\uc744 \uacbd\uc6b0, \ucd94\uac00\ub85c \uadf8 \ubaac\uc2a4\ud130\ub97c \ud328\uc5d0 \ub123\uc744 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Wyrm / Effect", "attribute": "LIGHT", "level": 4, "atk": 1200, "def": 900, "series": ["Clad Dragon"], "images": [{"index": 1, "image": "ShannahtheCladDragonResearcher-RDKP25-JP-R.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP017", "set_name": "Rising of the Aurora", "rarities": ["Rare", "Secret Rare"]}], "ko": [{"set_number": "RD/KP25-KR017", "set_name": "Rising of the Aurora", "rarities": ["Rare", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1184165}