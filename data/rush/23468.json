{"konami_id": 23468, "name": {"en": "Instant Fusion", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u7c21\u6613\u878d\u5408<rt>\u30a4\u30f3\u30b9\u30bf\u30f3\u30c8\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3</rt></ruby>", "ja_romaji": null, "ko": "\uc778\uc2a4\ud134\ud2b8 \ud4e8\uc804", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "During a turn you have not activated \"Instant Fusion\", pay 1000 LP.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u304c\u300c\u7c21\u6613\u878d\u5408\u300d\u3092\u767a\u52d5\u3057\u3066\u3044\u306a\u3044\u30bf\u30fc\u30f3\u306b\u3001\uff11\uff10\uff10\uff10\uff2c\uff30\u3092\u6255\u3063\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc790\uc2e0\uc774 \"\uc778\uc2a4\ud134\ud2b8 \ud4e8\uc804\"\uc744 \ubc1c\ub3d9\ud558\uace0 \uc788\uc9c0 \uc54a\uc740 \ud134\uc5d0, 1000 LP\ub97c \uc9c0\ubd88\ud558\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Fusion Summon 1 Level 5 or lower Fusion Monster without using materials. The monster Special Summoned by this effect cannot attack, and is sent to the Graveyard during the End Phase of this turn.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff15\u4ee5\u4e0b\uff09\uff11\u4f53\u3092\u7d20\u6750\u306a\u3057\u3067\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u53ec\u559a\u3059\u308b\u3002\u3053\u306e\u52b9\u679c\u3067\u7279\u6b8a\u53ec\u559a\u3057\u305f\u30e2\u30f3\u30b9\u30bf\u30fc\u306f\u653b\u6483\u3067\u304d\u305a\u3001\u3053\u306e\u30bf\u30fc\u30f3\u306e\u30a8\u30f3\u30c9\u30d5\u30a7\u30a4\u30ba\u306b\u5893\u5730\u3078\u9001\u3089\u308c\u308b\u3002", "ko": "\ud4e8\uc804 \ubaac\uc2a4\ud130(\ub808\ubca8 5 \uc774\ud558) 1\uc7a5\uc744 \uc18c\uc7ac \uc5c6\uc774 \ud4e8\uc804 \uc18c\ud658\ud55c\ub2e4. \uc774 \ud6a8\uacfc\ub85c \ud2b9\uc218 \uc18c\ud658\ud55c \ubaac\uc2a4\ud130\ub294 \uacf5\uaca9\ud560 \uc218 \uc5c6\uc73c\uba70, \uc774 \ud134\uc758 \uc5d4\ub4dc \ud398\uc774\uc988\uc5d0 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uc9c4\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Spell", "property": "Normal", "legend": true, "images": [{"index": 1, "image": "InstantFusion-RDAP03-JP-UR.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP053", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare"]}], "ko": [{"set_number": "RD/AP03-KR053", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare"]}]}, "is_translation_unofficial": {"text": {"en": true}}, "yugipedia_page_id": 1204860}