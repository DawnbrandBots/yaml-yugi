{"konami_id": 23455, "name": {"en": "Star Sanctuary of the Beginning", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u306f\u3058\u307e\u308a\u306e<ruby>\u661f<rt>\u305b\u3044</rt></ruby><ruby>\u57df<rt>\u3044\u304d</rt></ruby>", "ja_romaji": "Hajimari no Seiiki", "ko": "\uc2dc\uc791\uc758 \ubcc4\ub098\ub77c", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "summoning_condition": {"en": "This card's name becomes \"Star of Beginning\" while in the hand or Graveyard.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u624b\u672d\u307e\u305f\u306f\u5893\u5730\u306b\u3042\u308b\u3053\u306e\u30ab\u30fc\u30c9\u306e\u30ab\u30fc\u30c9\u540d\u306f\u300c\u306f\u3058\u307e\u308a\u306e\u661f\u300d\u306b\u306a\u308b\u3002", "ko": "\ud328 \ub610\ub294 \ubb18\uc9c0\uc5d0 \uc788\ub294 \uc774 \uce74\ub4dc\uc758 \uce74\ub4dc\uba85\uc740 \"\uc2dc\uc791\uc758 \ubcc4\"\uc774 \ub41c\ub2e4.", "zh-TW": null, "zh-CN": null}, "requirement": {"en": "When your opponent Normal Summons a monster, place 1 Fusion Monster or Normal Monster from your Graveyard on the bottom of the Deck.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u304c\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u53ec\u559a\u3057\u305f\u6642\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u30e2\u30f3\u30b9\u30bf\u30fc\u307e\u305f\u306f\u901a\u5e38\u30e2\u30f3\u30b9\u30bf\u30fc\uff11\u4f53\u3092\u30c7\u30c3\u30ad\u306e\u4e0b\u306b\u623b\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300\uac00 \ubaac\uc2a4\ud130\ub97c \uc77c\ubc18 \uc18c\ud658\ud588\uc744 \ub54c, \uc790\uc2e0 \ubb18\uc9c0\uc758 \ud4e8\uc804 \ubaac\uc2a4\ud130 \ub610\ub294 \uc77c\ubc18 \ubaac\uc2a4\ud130 1\uc7a5\uc744 \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9ac\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Change that Normal Summoned monster to face-down Defense Position. Then, if you placed a Fusion Monster to meet the requirement, you can destroy 1 face-down card on your opponent's field.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u305d\u306e\u53ec\u559a\u3055\u308c\u305f\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u88cf\u5074\u5b88\u5099\u8868\u793a\u306b\u3059\u308b\u3002\u3053\u306e\u52b9\u679c\u306e\u6761\u4ef6\u3067\u30d5\u30e5\u30fc\u30b8\u30e7\u30f3\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u623b\u3057\u305f\u5834\u5408\u3001\u3055\u3089\u306b\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u88cf\u5074\u8868\u793a\u306e\u30ab\u30fc\u30c9\uff11\u679a\u3092\u9078\u3093\u3067\u7834\u58ca\u3067\u304d\u308b\u3002", "ko": "\uadf8 \uc77c\ubc18 \uc18c\ud658\ub41c \ubaac\uc2a4\ud130\ub97c \ub4b7\uba74 \uc218\ube44 \ud45c\uc2dc\ub85c \ud55c\ub2e4. \uc774 \ud6a8\uacfc\uc758 \uc870\uac74\uc73c\ub85c \ud4e8\uc804 \ubaac\uc2a4\ud130\ub97c \ub418\ub3cc\ub838\uc744 \uacbd\uc6b0, \ucd94\uac00\ub85c \uc0c1\ub300 \ud544\ub4dc\uc758 \ub4b7\uba74 \ud45c\uc2dc\uc778 \uce74\ub4dc 1\uc7a5\uc744 \uace0\ub974\uace0 \ud30c\uad34\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Trap", "property": "Normal", "series": ["Pliage"], "images": [{"index": 1, "image": "StarSanctuaryoftheBeginning-RDAP03-JP-UR.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP027", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Over Rush Rare"]}], "ko": [{"set_number": "RD/AP03-KR027", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Over Rush Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1203876}