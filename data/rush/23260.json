{"konami_id": 23260, "name": {"en": "Hysteric Eyes", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30d2\u30b9\u30c6\u30ea\u30c3\u30af\u30fb\u30a2\u30a4\u30ba", "ja_romaji": "Hisuterikku Aizu", "ko": "\ud788\uc2a4\ud14c\ub9ad \uc544\uc774\uc988", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "When your opponent Normal Summons or Sets a monster from their hand, or when your opponent Special Summons a monster(s).", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u304c\u624b\u672d\u304b\u3089\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u53ec\u559a\u30fb\u30bb\u30c3\u30c8\u3057\u305f\u6642\u3001\u307e\u305f\u306f\u76f8\u624b\u304c\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u7279\u6b8a\u53ec\u559a\u3057\u305f\u6642\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300\uac00 \ud328\uc5d0\uc11c \ubaac\uc2a4\ud130\ub97c \uc77c\ubc18 \uc18c\ud658 / \uc138\ud2b8\ud588\uc744 \ub54c, \ub610\ub294 \uc0c1\ub300\uac00 \ubaac\uc2a4\ud130\ub97c \ud2b9\uc218 \uc18c\ud658\ud588\uc744 \ub54c\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Change the battle position of up to 2 monsters on your opponent's field. If you changed the battle position of a Ritual Monster by this effect, your opponent cannot activate the effects of monsters with the same original name as that Ritual Monster this turn.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\uff12\u4f53\u307e\u3067\u9078\u3093\u3067\u8868\u793a\u5f62\u5f0f\u3092\u5909\u66f4\u3059\u308b\u3002\u3053\u306e\u52b9\u679c\u3067\u8868\u793a\u5f62\u5f0f\u3092\u5909\u66f4\u3057\u305f\u30e2\u30f3\u30b9\u30bf\u30fc\u304c\u30ea\u30c1\u30e5\u30a2\u30eb\u30e2\u30f3\u30b9\u30bf\u30fc\u306e\u5834\u5408\u3001\u3053\u306e\u30bf\u30fc\u30f3\u3001\u76f8\u624b\u306f\u305d\u306e\u30ea\u30c1\u30e5\u30a2\u30eb\u30e2\u30f3\u30b9\u30bf\u30fc\u3068\u5143\u3005\u306e\u30ab\u30fc\u30c9\u540d\u304c\u540c\u3058\u30e2\u30f3\u30b9\u30bf\u30fc\u306e\u52b9\u679c\u3092\u767a\u52d5\u3067\u304d\u306a\u3044\u3002", "ko": "\uc0c1\ub300 \ud544\ub4dc\uc758 \ubaac\uc2a4\ud130\ub97c 2\uc7a5\uae4c\uc9c0 \uace0\ub974\uace0 \ud45c\uc2dc \ud615\uc2dd\uc744 \ubcc0\uacbd\ud55c\ub2e4. \uc774 \ud6a8\uacfc\ub85c \ud45c\uc2dc \ud615\uc2dd\uc744 \ubcc0\uacbd\ud55c \ubaac\uc2a4\ud130\uac00 \ub9ac\ucd94\uc5bc \ubaac\uc2a4\ud130\uc77c \uacbd\uc6b0, \uc774 \ud134\uc5d0, \uc0c1\ub300\ub294 \uadf8 \ub9ac\ucd94\uc5bc \ubaac\uc2a4\ud130\uc640 \uc6d0\ub798\uc758 \uce74\ub4dc\uba85\uc774 \uac19\uc740 \ubaac\uc2a4\ud130\uc758 \ud6a8\uacfc\ub97c \ubc1c\ub3d9\ud560 \uc218 \uc5c6\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Trap", "property": "Normal", "images": [{"index": 1, "image": "HystericEyes-RDKP25-JP-UR.png"}, {"index": 2, "image": "HystericEyes-RDKP25-JP-ORR-AA.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP063", "set_name": "Rising of the Aurora", "rarities": ["Ultra Rare", "Secret Rare", "Over Rush Rare"]}], "ko": [{"set_number": "RD/KP25-KR063", "set_name": "Rising of the Aurora", "rarities": ["Ultra Rare", "Secret Rare", "Over Rush Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1187162}