{"konami_id": 23081, "name": {"en": "Speed Carrier", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30b9\u30d4\u30fc\u30c9\u30fb\u30ad\u30e3\u30ea\u30a2\u30fc", "ja_romaji": "Sup\u012bdo Kyari\u0101", "ko": "\uc2a4\ud53c\ub4dc \uce90\ub9ac\uc5b4", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "During your Main Phase that you Normal or Special Summoned this card.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u3092\u53ec\u559a\u30fb\u7279\u6b8a\u53ec\u559a\u3057\u305f\u81ea\u5206\u30e1\u30a4\u30f3\u30d5\u30a7\u30a4\u30ba\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc774 \uce74\ub4dc\ub97c \uc77c\ubc18 \uc18c\ud658 / \ud2b9\uc218 \uc18c\ud658\ud55c \uc790\uc2e0 \uba54\uc778 \ud398\uc774\uc988\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Special Summon 1 Level 3 or 4 WIND Attribute Warrior Type Effect Monster with 1000 or more ATK from your Graveyard face-up to your field. Then, you can add 1 \"Speed Up\" or \"Speed Turn\" from your Graveyard to your hand. This turn, you can only attack with Warrior Type monsters.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u5893\u5730\u306e\u52b9\u679c\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff13\u30fb\uff14\uff0f\u98a8\u5c5e\u6027\uff0f\u6226\u58eb\u65cf\uff0f\u653b\u6483\u529b\uff11\uff10\uff10\uff10\u4ee5\u4e0a\uff09\uff11\u4f53\u3092\u9078\u3073\u3001\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3059\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u300c\u30b9\u30d4\u30fc\u30c9\u30fb\u30a2\u30c3\u30d7\u300d\u307e\u305f\u306f\u300c\u30b9\u30d4\u30fc\u30c9\u30fb\u30bf\u30fc\u30f3\u300d\uff11\u679a\u3092\u9078\u3093\u3067\u624b\u672d\u306b\u52a0\u3048\u308b\u4e8b\u304c\u3067\u304d\u308b\u3002\u3053\u306e\u30bf\u30fc\u30f3\u3001\u81ea\u5206\u306f\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u6226\u58eb\u65cf\u4ee5\u5916\uff09\u3067\u653b\u6483\u3067\u304d\u306a\u3044\u3002", "ko": "\uc790\uc2e0 \ubb18\uc9c0\uc758 \ud6a8\uacfc \ubaac\uc2a4\ud130(\ub808\ubca8 3\u30fb4 / \ubc14\ub78c \uc18d\uc131 / \uc804\uc0ac\uc871 / \uacf5\uaca9\ub825 1000 \uc774\uc0c1) 1\uc7a5\uc744 \uace0\ub974\uace0, \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud55c\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0 \ubb18\uc9c0\uc758 \"\uc2a4\ud53c\ub4dc \uc5c5\" \ub610\ub294 \"\uc2a4\ud53c\ub4dc \ud134\" 1\uc7a5\uc744 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\uc744 \uc218 \uc788\ub2e4. \uc774 \ud134\uc5d0, \uc790\uc2e0\uc740 \ubaac\uc2a4\ud130(\uc804\uc0ac\uc871 \uc774\uc678)\ub85c \uacf5\uaca9\ud560 \uc218 \uc5c6\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Warrior / Effect", "attribute": "WIND", "level": 5, "atk": 1500, "def": 1200, "series": ["Speed"], "images": [{"index": 1, "image": "SpeedCarrier-RDORP4-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/ORP4-JP059", "set_name": "Over Rush Pack 4", "rarities": ["Common"]}], "ko": [{"set_number": "RD/ORP4-KR059", "set_name": "Over Rush Pack 4", "rarities": ["Common"]}]}, "is_translation_unofficial": {"text": {"en": true}}, "yugipedia_page_id": 1182864}