{"konami_id": 23252, "name": {"en": "Rising Protect", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\uff32<rt>\u30e9\u30a4\u30b8\u30f3\u30b0</rt></ruby>\u30fb\u30d7\u30ed\u30c6\u30af\u30c8", "ja_romaji": "Raijingu Purotekuto", "ko": "R \ud504\ub85c\ud14d\ud2b8", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "Place 1 card from your hand on the bottom of the Deck.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u624b\u672d\uff11\u679a\u3092\u30c7\u30c3\u30ad\u306e\u4e0b\u306b\u623b\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\ud328 1\uc7a5\uc744 \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9ac\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Add 1 Level 3 LIGHT Attribute Warrior Type monster with 1000 DEF and/or 1 \"Rising Equip\" from your Graveyard to your hand. Then, you can choose 1 face-up monster on your field. This turn, that monster cannot be destroyed by card effects.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff13\uff0f\u5149\u5c5e\u6027\uff0f\u6226\u58eb\u65cf\uff0f\u5b88\u5099\u529b\uff11\uff10\uff10\uff10\uff09\u3068\u300c\uff32\u30fb\u30a4\u30af\u30a4\u30c3\u30d7\u300d\u3092\u305d\u308c\u305e\u308c\uff11\u679a\u307e\u3067\u9078\u3093\u3067\u624b\u672d\u306b\u52a0\u3048\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u8868\u5074\u8868\u793a\u30e2\u30f3\u30b9\u30bf\u30fc\uff11\u4f53\u3092\u9078\u3076\u4e8b\u304c\u3067\u304d\u308b\u3002\u9078\u3093\u3060\u5834\u5408\u3001\u3053\u306e\u30bf\u30fc\u30f3\u3001\u305d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u306f\u52b9\u679c\u3067\u306f\u7834\u58ca\u3055\u308c\u306a\u3044\u3002", "ko": "\uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ub808\ubca8 3 / \ube5b \uc18d\uc131 / \uc804\uc0ac\uc871 / \uc218\ube44\ub825 1000)\uc640 \"R(\ub77c\uc774\uc9d5) \uc774\ud045\"\uc744 \uac01\uac01 1\uc7a5\uae4c\uc9c0 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\ub294\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0 \ud544\ub4dc\uc758 \uc55e\uba74 \ud45c\uc2dc \ubaac\uc2a4\ud130 1\uc7a5\uc744 \uace0\ub97c \uc218 \uc788\ub2e4. \uace0\ub978 \uacbd\uc6b0, \uc774 \ud134\uc5d0, \uadf8 \ubaac\uc2a4\ud130\ub294 \ud6a8\uacfc\ub85c\ub294 \ud30c\uad34\ub418\uc9c0 \uc54a\ub294\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Spell", "property": "Normal", "series": ["Rising HERO"], "images": [{"index": 1, "image": "RisingProtect-RDKP25-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP055", "set_name": "Rising of the Aurora", "rarities": ["Common"]}], "ko": [{"set_number": "RD/KP25-KR055", "set_name": "Rising of the Aurora", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1192749}