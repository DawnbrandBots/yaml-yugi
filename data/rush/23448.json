{"konami_id": 23448, "name": {"en": "Star Replete", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30b9\u30bf\u30fc\u30fb\u30ea\u30d7\u30ea\u30fc\u30c8", "ja_romaji": "Sut\u0101 Ripur\u012bto", "ko": "\uc2a4\ud0c0 \ub9ac\ud50c\ub9ac\ud2b8", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "text": {"en": "The tiny star dragon has grown and taken on a new form. Fueled by its bonds with people and the power of the stars, it contains a mysterious power within its body. When the fated hour comes, its name will be engraved in the star sanctuary.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u5c0f\u3055\u306a\u661f\u306e\u7adc\u306f\u6210\u9577\u3092\u9042\u3052\u3001\u65b0\u305f\u306a\u59ff\u3078\u3068\u6607\u83ef\u3057\u305f\u3002\u4eba\u3068\u306e\u7d46\u3001\u305d\u3057\u3066\u661f\u3005\u306e\u529b\u3092\u7ce7\u306b\u3001\u795e\u79d8\u306e\u529b\u3092\u305d\u306e\u8eab\u306b\u5bbf\u3059\u3002\u3084\u304c\u3066\u6765\u308b\u904b\u547d\u306e\u6642\u3001\u305d\u306e\u540d\u306f\u661f\u57df\u306b\u523b\u307e\u308c\u308b\u3002", "ko": "\uc791\uc740 \ubcc4\uc758 \uc6a9\uc740 \uc131\uc7a5\uc744 \uc774\ub8e8\uc5b4, \uc0c8\ub85c\uc6b4 \ubaa8\uc2b5\uc73c\ub85c \uc2b9\ud654\ud588\ub2e4. \uc0ac\ub78c\uacfc\uc758 \uc720\ub300, \uadf8\ub9ac\uace0 \ubcc4\ub4e4\uc758 \ud798\uc744 \uc591\ubd84 \uc0bc\uc544, \uc2e0\ube44\ub85c\uc6b4 \ud798\uc744 \uadf8 \ubab8\uc5d0 \ud488\ub294\ub2e4. \uc774\uc73d\uace0 \ucc3e\uc544\uc62c \uc6b4\uba85\uc758 \uc2dc\uac04, \uadf8 \uc774\ub984\uc740 \ubcc4\ub4e4\uc758 \uc601\uc5ed\uc5d0 \uc0c8\uaca8\uc9c0\ub9ac\ub77c.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Dragon / Normal", "attribute": "LIGHT", "level": 5, "atk": 2100, "def": 2100, "series": ["Pliage"], "images": [{"index": 1, "image": "StarReplete-RDAP03-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP017", "set_name": "Advance Pack: Union Base", "rarities": ["Common", "Secret Rare"]}], "ko": [{"set_number": "RD/AP03-KR017", "set_name": "Advance Pack: Union Base", "rarities": ["Common", "Secret Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1196056}