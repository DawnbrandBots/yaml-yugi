{"konami_id": 23080, "name": {"en": "Speed Commander", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u30b9\u30d4\u30fc\u30c9\u30fb\u30b3\u30de\u30f3\u30c0\u30fc", "ja_romaji": "Sup\u012bdo Komand\u0101", "ko": "\uc2a4\ud53c\ub4dc \ucee4\ub9e8\ub354", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "requirement": {"en": "During your Main Phase that you Normal or Special Summoned this card.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u3092\u53ec\u559a\u30fb\u7279\u6b8a\u53ec\u559a\u3057\u305f\u81ea\u5206\u30e1\u30a4\u30f3\u30d5\u30a7\u30a4\u30ba\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc774 \uce74\ub4dc\ub97c \uc77c\ubc18 \uc18c\ud658 / \ud2b9\uc218 \uc18c\ud658\ud55c \uc790\uc2e0 \uba54\uc778 \ud398\uc774\uc988\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Special Summon 1 Level 3-5 Warrior Type Effect Monster from your hand face-up to your field. Then, you can add 1 Warrior Type monster with 1400 ATK/100 DEF from your Graveyard to your hand. This turn, you cannot activate the effect of \"Speed Commander\".", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u624b\u672d\u306e\u52b9\u679c\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff13\uff5e\uff15\uff0f\u6226\u58eb\u65cf\uff09\uff11\u4f53\u3092\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3059\u308b\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u6226\u58eb\u65cf\uff0f\u653b\u6483\u529b\uff11\uff14\uff10\uff10\uff0f\u5b88\u5099\u529b\uff11\uff10\uff10\uff09\uff11\u4f53\u3092\u9078\u3093\u3067\u624b\u672d\u306b\u52a0\u3048\u308b\u4e8b\u304c\u3067\u304d\u308b\u3002\u3053\u306e\u30bf\u30fc\u30f3\u3001\u81ea\u5206\u306f\u300c\u30b9\u30d4\u30fc\u30c9\u30fb\u30b3\u30de\u30f3\u30c0\u30fc\u300d\u306e\u52b9\u679c\u3092\u767a\u52d5\u3067\u304d\u306a\u3044\u3002", "ko": "\ud328\uc758 \ud6a8\uacfc \ubaac\uc2a4\ud130(\ub808\ubca8 3~5 / \uc804\uc0ac\uc871) 1\uc7a5\uc744 \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud55c\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\uc804\uc0ac\uc871 / \uacf5\uaca9\ub825 1400 / \uc218\ube44\ub825 100) 1\uc7a5\uc744 \uace0\ub974\uace0 \ud328\uc5d0 \ub123\uc744 \uc218 \uc788\ub2e4. \uc774 \ud134\uc5d0, \uc790\uc2e0\uc740 \"\uc2a4\ud53c\ub4dc \ucee4\ub9e8\ub354\"\uc758 \ud6a8\uacfc\ub97c \ubc1c\ub3d9\ud560 \uc218 \uc5c6\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Warrior / Effect", "attribute": "WIND", "level": 5, "atk": 1500, "def": 1600, "series": ["Speed"], "images": [{"index": 1, "image": "SpeedCommander-RDORP4-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/ORP4-JP058", "set_name": "Over Rush Pack 4", "rarities": ["Common"]}], "ko": [{"set_number": "RD/ORP4-KR058", "set_name": "Over Rush Pack 4", "rarities": ["Common"]}]}, "is_translation_unofficial": {"text": {"en": true}}, "yugipedia_page_id": 1182863}