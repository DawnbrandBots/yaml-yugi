": null, "ja": "\u3053\u306e\u30ab\u30fc\u30c9\u3092\u7279\u6b8a\u53ec\u559a\u3057\u305f\u81ea\u5206\u30e1\u30a4\u30f3\u30d5\u30a7\u30a4\u30ba\u306b\u3001\u81ea\u5206\u306e\u5893\u5730\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u30ec\u30d9\u30eb\uff18\uff09\uff11\u4f53\u3092\u30c7\u30c3\u30ad\u306e\u4e0b\u306b\u623b\u3057\u3066\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc774 \uce74\ub4dc\ub97c \ud2b9\uc218 \uc18c\ud658\ud55c \uc790\uc2e0 \uba54\uc778 \ud398\uc774\uc988\uc5d0, \uc790\uc2e0 \ubb18\uc9c0\uc758 \ubaac\uc2a4\ud130(\ub808\ubca8 8) 1\uc7a5\uc744 \ub371 \uc544\ub798\ub85c \ub418\ub3cc\ub9ac\uace0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Destroy 1 monster on your opponent's field. Then, inflict 500 damage to your opponent.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff11\u4f53\u3092\u9078\u3093\u3067\u7834\u58ca\u3059\u308b\u3002\u305d\u306e\u5f8c\u3001\u76f8\u624b\u306b\uff15\uff10\uff10\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3002", "ko": "\uc0c1\ub300 \ud544\ub4dc\uc758 \ubaac\uc2a4\ud130 1\uc7a5\uc744 \uace0\ub974\uace0 \ud30c\uad34\ud55c\ub2e4. \uadf8 \ud6c4, \uc0c1\ub300\uc5d0\uac8c 500 \ub370\ubbf8\uc9c0\ub97c \uc900\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Monster", "monster_type_line": "Warrior / Effect", "attribute": "FIRE", "level": 8, "atk": 2600, "def": 2000, "series": ["Baseball"], "images": [{"index": 1, "image": "PlayerC39HomeRunSmasherV-RDAP03-JP-UR.png"}], "sets": {"ja": [{"set_number": "RD/AP03-JP028", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Over Rush Rare"]}], "ko": [{"set_number": "RD/AP03-KR028", "set_name": "Advance Pack: Union Base", "rarities": ["Ultra Rare", "Over Rush Rare"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1196053}