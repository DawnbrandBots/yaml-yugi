{"konami_id": 23257, "name": {"en": "Major Breaking News!", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "<ruby>\u5927<rt>\u3060\u3044</rt></ruby><ruby>\u4e8b<rt>\u3058</rt></ruby><ruby>\u4ef6<rt>\u3051\u3093</rt></ruby>\u3067\u3059\uff01", "ja_romaji": "Daijiken desu!", "ko": "\ub300\uc0ac\uac74\uc785\ub2c8\ub2e4!", "ko_rr": null, "zh-TW": null, "zh-CN": null}, "summoning_condition": {"en": "This card's name becomes \"Soul of a Reporter\" while in the Graveyard.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u5893\u5730\u306b\u3042\u308b\u3053\u306e\u30ab\u30fc\u30c9\u306e\u30ab\u30fc\u30c9\u540d\u306f\u300c\u5831\u9053\u9b42\u300d\u306b\u306a\u308b\u3002", "ko": "\ubb18\uc9c0\uc5d0 \uc788\ub294 \uc774 \uce74\ub4dc\uc758 \uce74\ub4dc\uba85\uc740 \"\ubcf4\ub3c4 \uc815\uc2e0\"\uc774 \ub41c\ub2e4.", "zh-TW": null, "zh-CN": null}, "requirement": {"en": "When a card(s) is sent to your opponent's Graveyard during their Main Phase.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u30e1\u30a4\u30f3\u30d5\u30a7\u30a4\u30ba\u306b\u3001\u30ab\u30fc\u30c9\u304c\u76f8\u624b\u306e\u5893\u5730\u3078\u9001\u3089\u308c\u305f\u6642\u306b\u767a\u52d5\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300 \uba54\uc778 \ud398\uc774\uc988\uc5d0, \uce74\ub4dc\uac00 \uc0c1\ub300\uc758 \ubb18\uc9c0\ub85c \ubcf4\ub0b4\uc84c\uc744 \ub54c\uc5d0 \ubc1c\ub3d9\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "effect": {"en": "Place up to 2 cards from your opponent's Graveyard on top of the Deck in any order. Then, you can Special Summon up to 2 EARTH Attribute Machine Type monsters from your hand to your field in face-up Defense Position.", "de": null, "es": null, "fr": null, "it": null, "pt": null, "ja": "\u76f8\u624b\u306e\u5893\u5730\u306e\u30ab\u30fc\u30c9\u3092\uff12\u679a\u307e\u3067\u9078\u3093\u3067\u597d\u304d\u306a\u9806\u756a\u3067\u30c7\u30c3\u30ad\u306e\u4e0a\u306b\u623b\u3059\u3002\u305d\u306e\u5f8c\u3001\u81ea\u5206\u306f\u624b\u672d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\uff08\u5730\u5c5e\u6027\uff0f\u6a5f\u68b0\u65cf\uff09\u3092\uff12\u4f53\u307e\u3067\u81ea\u5206\u30d5\u30a3\u30fc\u30eb\u30c9\u306b\u8868\u5074\u5b88\u5099\u8868\u793a\u3067\u7279\u6b8a\u53ec\u559a\u3067\u304d\u308b\u3002", "ko": "\uc0c1\ub300 \ubb18\uc9c0\uc758 \uce74\ub4dc\ub97c 2\uc7a5\uae4c\uc9c0 \uace0\ub974\uace0 \uc88b\uc544\ud558\ub294 \uc21c\uc11c\ub300\ub85c \ub371 \uc704\ub85c \ub418\ub3cc\ub9b0\ub2e4. \uadf8 \ud6c4, \uc790\uc2e0\uc740 \ud328\uc758 \ubaac\uc2a4\ud130(\ub545 \uc18d\uc131 / \uae30\uacc4\uc871)\ub97c 2\uc7a5\uae4c\uc9c0 \uc790\uc2e0 \ud544\ub4dc\uc5d0 \uc55e\uba74 \uc218\ube44 \ud45c\uc2dc\ub85c \ud2b9\uc218 \uc18c\ud658\ud560 \uc218 \uc788\ub2e4.", "zh-TW": null, "zh-CN": null}, "card_type": "Trap", "property": "Normal", "series": ["Reporter"], "images": [{"index": 1, "image": "MajorBreakingNews-RDKP25-JP-C.png"}], "sets": {"ja": [{"set_number": "RD/KP25-JP060", "set_name": "Rising of the Aurora", "rarities": ["Common"]}], "ko": [{"set_number": "RD/KP25-KR060", "set_name": "Rising of the Aurora", "rarities": ["Common"]}]}, "is_translation_unofficial": {"name": {"en": true}, "text": {"en": true}}, "yugipedia_page_id": 1187991}